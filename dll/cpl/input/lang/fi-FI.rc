LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_PROPPAGESETTINGS DIALOGEX 0, 0, 254, 228
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Asetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Oletusarvoinen syöttö&kieli", -1, 5, 5, 246, 55
    LTEXT "Valitse yksi asennetuista syöttökielistä käytettäväksi tietokoneen käynnistyessä.", -1, 15, 15, 230, 23
    COMBOBOX IDC_DEFAULT_LANGUAGE, 15, 40, 230, 300, CBS_HASSTRINGS | CBS_AUTOHSCROLL | CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "Asennetut &palvelut", -1, 5, 65, 246, 125
    LTEXT "Valitse luettelossa näkyville syöttökielille haluamasi palvelut. Muokkaa luetteloa Lisää- ja Poista-painikkeilla.", -1, 15, 78, 230, 25
    CONTROL "", IDC_KEYLAYOUT_LIST, "SysTreeView32", TVS_SHOWSELALWAYS | TVS_DISABLEDRAGDROP | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 15, 105, 155, 80
    PUSHBUTTON "Lis&ää...", IDC_ADD_BUTTON, 175, 105, 70, 14
    PUSHBUTTON "&Poista", IDC_REMOVE_BUTTON, 175, 125, 70, 14
    PUSHBUTTON "&Ominaisuudet...", IDC_PROP_BUTTON, 175, 145, 70, 14
    GROUPBOX "Asetukset", -1, 5, 195, 245, 30
    PUSHBUTTON "Kieli&palkki...", IDC_LANGUAGE_BAR, 15, 205, 110, 14
    PUSHBUTTON "&Näppäinasetukset...", IDC_KEY_SET_BTN, 133, 205, 110, 14
END

IDD_PROPPAGEADVANCEDSETTINGS DIALOGEX 0, 0, 254, 228
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Lisäasetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Järjestelmän määritys", -1, 7, 7, 240, 70
    AUTOCHECKBOX "&Poista kehittyneet tekstipalvelut käytöstä", IDC_TURNOFFTEXTSVCS_CB, 14, 20, 220, 12
    LTEXT "Valitse tämä ruutu poistaaksesi kehittyneet tekstipalvelut käytöstä kaikissa ohjelmissa.\nTätä ei suositella itäaasialaisille käyttäjille, koska kielipalkki poistuu käytöstä.", -1, 14, 40, 230, 35
END

IDD_KEYSETTINGS DIALOGEX 0, 0, 272, 163
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "Lisänäppäinasetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Caps Lockin poistaminen", -1, 7, 7, 258, 26
    AUTORADIOBUTTON "Paina CAPS &LOCK -näppäintä", IDC_PRESS_CL_KEY_RB, 14, 17, 120, 11, WS_GROUP
    AUTORADIOBUTTON "Paina SHI&FT-näppäintä", IDC_PRESS_SHIFT_KEY_RB, 144, 17, 120, 11, NOT WS_TABSTOP
    GROUPBOX "Syöttökielten pikanäppäimet", -1, 7, 37, 258, 95
    LTEXT "Toiminto", -1, 14, 47, 60, 9
    RTEXT "&Näppäinyhdistelmä", -1, 177, 47, 79, 9
    CONTROL "", IDC_KEY_LISTVIEW, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_AUTOARRANGE | LVS_SINGLESEL, 14, 57, 244, 52, WS_EX_CLIENTEDGE
    PUSHBUTTON "&Vaihda näppäinyhdistelmä...", IDC_CHANGE_KEY_SEQ_BTN, 152, 113, 106, 14, WS_GROUP
    DEFPUSHBUTTON "OK", IDOK, 66, 140, 70, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 146, 140, 70, 14
END

IDD_ADD DIALOGEX 20, 20, 227, 90
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "Lisää syöttökieli"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Syöttökieli:", -1, 7, 7, 61, 10
    COMBOBOX IDC_INPUT_LANG_COMBO, 7, 17, 212, 150, CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Näppäimistöasettelu/IME:", -1, 7, 36, 110, 10
    COMBOBOX IDC_KEYBOARD_LO_COMBO, 7, 47, 212, 150, CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 116, 68, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 169, 68, 50, 14
END

IDD_CHANGE_KEY_SEQ DIALOGEX 5, 100, 230, 125
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "Vaihda näppäinyhdistelmä"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "", -1, 9, 5, 155, 110
    AUTOCHECKBOX "&Vaihda syöttökieli", IDC_SWITCH_INPUT_LANG_CB, 15, 15, 105, 12
    LTEXT "Shift", -1, 73, 37, 27, 12
    CTEXT "+", -1, 62, 37, 8, 9
    AUTORADIOBUTTON "&Ctrl", IDC_CTRL_LANG, 29, 31, 30, 11
    AUTORADIOBUTTON "Vasen &ALT", IDC_LEFT_ALT_LANG, 29, 45, 46, 12
    AUTOCHECKBOX "Vaihda &näppäimistöasettelua", IDC_SWITCH_KBLAYOUTS_CB, 16, 65, 141, 12
    LTEXT "Shift", -1, 74, 87, 27, 12
    CTEXT "+", -1, 63, 87, 8, 9
    AUTORADIOBUTTON "C&trl", IDC_CTRL_LAYOUT, 30, 81, 30, 11
    AUTORADIOBUTTON "Vasen A&LT", IDC_LEFT_ALT_LAYOUT, 30, 95, 44, 12
    DEFPUSHBUTTON "OK", IDOK, 172, 9, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 172, 27, 50, 14
END

IDD_INPUT_LANG_PROP DIALOGEX 20, 20, 227, 75
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_CONTEXTHELP | WS_POPUPWINDOW | WS_VISIBLE | WS_CAPTION
CAPTION "Syöttökielen ominaisuudet"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Syöttökieli:", -1, 7, 7, 61, 8
    LTEXT "", IDC_INPUT_LANG_STR, 73, 7, 129, 8
    LTEXT "&Näppäimistöasettelu/IME:", -1, 7, 21, 110, 10
    COMBOBOX IDC_KB_LAYOUT_IME_COMBO, 7, 32, 212, 150, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 116, 53, 52, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 169, 53, 52, 14
END

