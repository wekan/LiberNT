IDD_HWSTATUSPAGE DIALOGEX 0, 0, 317, 186
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ohjattu laiteasennus"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Ohjatun laiteasennuksen viimeistely", IDC_FINISHTITLE, 114, 8, 195, 28
    LTEXT "Valitsemasi laitteiston nykyinen tila on seuraava:", -1, 114, 40, 193, 19
    EDITTEXT IDC_HWSTATUSEDIT, 114, 60, 193, 70, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    LTEXT "Jos haluat käynnistää vianmäärityksen mahdollisten ongelmien ratkaisemiseksi, valitse Valmis.", -1, 114, 136, 193, 16
    LTEXT "Poistu ohjatusta toiminnosta valitsemalla Peruuta.", IDC_STATUSTEXT, 114, 166, 132, 8
END

IDD_NOTCONNECTEDPAGE DIALOGEX 0, 0, 317, 186
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ohjattu laiteasennus"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Ohjattua laiteasennusta ei voi jatkaa", IDC_FINISHTITLE, 114, 8, 203, 28
    LTEXT "Jatka liittämällä tämä laitteisto tietokoneeseen.", -1, 114, 40, 193, 16
    AUTOCHECKBOX "&Sammuta tietokone, kun valitsen Valmis, jotta voin avata tietokoneen ja liittää laitteiston.", IDC_TURNOFFCHECKBOX, 114, 64, 203, 20, BS_TOP | BS_MULTILINE
    LTEXT "Useimmissa tapauksissa LiberNT asentaa laitteiston automaattisesti, kun se liitetään. Jos LiberNT ei löydä sitä, voit avata tämän ohjatun toiminnon uudelleen asentaaksesi tukiohjelmiston.", -1, 114, 98, 193, 32
    LTEXT "Sulje tämä ohjattu toiminto valitsemalla Valmis.", IDC_STATUSTEXT, 114, 166, 193, 8
END

IDD_SELECTDRIVERPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ohjattu laiteasennus"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON "", IDC_SELDRVICON, 14, 8, 20, 20
    LTEXT "Valitse laitteen valmistaja ja malli ja valitse sitten Seuraava. Jos sinulla on levy, jolla asennettava ohjain on, valitse Levy.", IDC_STATUSTEXT, 44, 8, 266, 26
    CONTROL "", IDC_MFGLIST, "SysListView32", WS_BORDER | WS_GROUP | WS_TABSTOP | LVS_REPORT | LVS_NOSORTHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING, 7, 40, 112, 76
    CONTROL "", IDC_MODELLIST, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_NOSORTHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_SHAREIMAGELISTS, 125, 40, 185, 76
    PUSHBUTTON "&Levy...", IDC_HAVEDISK, 240, 122, 70, 14
END

IDD_READYPAGE DIALOGEX 0, 0, 317, 143
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ohjattu laiteasennus"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Asennettava laitteisto:", -1, 21, 8, 275, 8
    ICON "", IDC_READYICON, 28, 24, 20, 20
    LTEXT "", IDC_READYDEVICE, 58, 30, 238, 8, SS_NOPREFIX
    LTEXT "Aloita uuden laitteiston asennus valitsemalla Seuraava.", IDC_STATUSTEXT, 21, 60, 275, 8
END

STRINGTABLE
BEGIN
    IDS_CPLNAME "Lisää laitteisto"
    IDS_CPLDESCRIPTION "Lisää laitteisto tietokoneeseen."
    IDS_SEARCHTITLE "Odota, kun ohjattu toiminto etsii laitteistoa..."
    IDS_SEARCHTEXT "Ohjattu toiminto etsii laitteistoa, joka on äskettäin liitetty tietokoneeseen, mutta jota ei ole vielä asennettu."
    IDS_ISCONNECTED "Onko laitteisto liitetty?"
    IDS_PROBELISTTITLE "Seuraava laitteisto on jo asennettu tietokoneeseen"
    IDS_ADDNEWDEVICE "Lisää uusi laite"
    IDS_SELECTWAYTITLE "Ohjattu toiminto voi auttaa sinua asentamaan muuta laitteistoa"
    IDS_NOTFOUNDTITLE "Ohjattu toiminto ei löytänyt tietokoneesta uutta laitteistoa"
    IDS_NOTFOUNDTEXT "Jos tiedät asennettavan laitemallin, valitse Seuraava ja valitse se luettelosta."
    IDS_FOUNDTITLE "Ohjattu toiminto löysi tietokoneesta seuraavan laitteiston"
    IDS_SELECTDRIVERTITLE "Valitse tälle laitteistolle asennettava laiteohjain."
    IDS_READYTITLE "Ohjattu toiminto on valmis asentamaan laitteiston"
