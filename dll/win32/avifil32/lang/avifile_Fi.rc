LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
{
  IDS_WAVESTREAMFORMAT	"Aaltomuoto: %s"
  IDS_WAVEFILETYPE	"Aaltomuoto"
  IDS_ALLMULTIMEDIA	"Kaikki multimediatiedostot"
  IDS_ALLFILES		"Kaikki tiedostot (*.*)"
  IDS_VIDEO		"video"
  IDS_AUDIO		"ääni"
  IDS_AVIFILETYPE	"Wine AVI -oletustiedostokäsittelijä"
  IDS_UNCOMPRESSED      "pakkaamaton"
}

IDD_SAVEOPTIONS DIALOGEX  43, 37, 226, 82
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Pakkausasetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&Valitse virta:",-1,5,5,154,10
    COMBOBOX        IDC_STREAM,5,18,154,61,CBS_DROPDOWNLIST | WS_VSCROLL |
                    WS_TABSTOP
    PUSHBUTTON      "&Asetukset...",IDC_OPTIONS,170,17,50,14
    AUTOCHECKBOX    "&Lomita joka",IDC_INTERLEAVE,5,42,85,11,WS_TABSTOP
    EDITTEXT        IDC_INTERLEAVEEVERY,91,41,32,12,ES_AUTOHSCROLL
    LTEXT           "kuva",-1,129,43,36,9
    LTEXT           "Nykyinen muoto:",-1,5,56,73,9
    LTEXT           "",IDC_FORMATTEXT,80,56,88,26
    DEFPUSHBUTTON   "OK",IDOK,170,42,50,14
    PUSHBUTTON      "Peruuta",IDCANCEL,170,61,50,14
END
