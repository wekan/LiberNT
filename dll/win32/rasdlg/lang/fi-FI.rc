    AUTOCHECKBOX "M&icrosoft CHAP versio 2 (MS-CHAP v2)", 1492, 28, 176, 200, 10, BS_TOP | BS_MULTILINE
    CONTROL "", -1, "STATIC", SS_LEFTNOWORDWRAP | SS_SUNKEN | WS_GROUP, 28, 189, 208, 1
    AUTOCHECKBOX "&Käytä MS-CHAP-pohjaisissa protokollissa automaattisesti LiberNT-kirjautumisnimeäni ja -salasanaani (ja toimialuetta, jos sellainen on)", 1549, 28, 195, 213, 24, BS_TOP | BS_MULTILINE
    DEFPUSHBUTTON "OK", 1, 127, 232, 60, 14
    PUSHBUTTON "Peruuta", 2, 192, 232, 60, 14
