    COMBOBOX 1495, 7, 17, 247, 76, CBS_DROPDOWNLIST | WS_VSCROLL | NOT WS_TABSTOP
    AUTORADIOBUTTON "Käytä &EAP (Extensible Authentication Protocol) -protokollaa", 1544, 17, 47, 226, 8, WS_GROUP
    LTEXT "EAP-tyyppi", -1, 18, 64, 35, 8, NOT WS_VISIBLE | NOT WS_GROUP
    COMBOBOX 1034, 53, 62, 191, 42, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | NOT WS_TABSTOP
    PUSHBUTTON "&Ominaisuudet", 1035, 184, 77, 60, 14
    AUTORADIOBUTTON "Salli nämä &protokollat", 1545, 17, 92, 224, 10
    AUTOCHECKBOX "&Salaamaton salasana (PAP)", 1491, 28, 105, 215, 10, BS_TOP | BS_MULTILINE | WS_GROUP
    AUTOCHECKBOX "S&hiva Password Authentication Protocol (SPAP)", 1496, 28, 119, 214, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "&Challenge Handshake Authentication Protocol (CHAP)", 1494, 28, 133, 215, 10, BS_TOP | BS_MULTILINE
