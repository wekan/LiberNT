LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

102 DIALOGEX 0, 0, 255, 265
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
CAPTION "Vaihtoehtoiset puhelinnumerot"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Määritä vaihtoehtoiset puhelinnumerot, joita haluat käyttää tämän yhteyden muodostamiseen.", 1018, 7, 5, 243, 16
    LTEXT "&Puhelinnumerot:", 1019, 7, 27, 238, 8
    CONTROL "", 1012, "SYSLISTVIEW32", WS_BORDER | WS_TABSTOP | 0x0000848D, 7, 38, 217, 144
    PUSHBUTTON "Siirrä &ylös", 1017, 230, 40, 18, 16, BS_ICON
    PUSHBUTTON "Siirrä &alas", 1015, 230, 61, 18, 16, BS_ICON
    PUSHBUTTON "&Lisää...", 1013, 7, 187, 70, 14
    PUSHBUTTON "&Muokkaa...", 1016, 81, 187, 70, 14
    PUSHBUTTON "P&oista", 1014, 154, 187, 70, 14
    AUTOCHECKBOX "Jos &numero ei vastaa, kokeile seuraavaa numeroa", 1011, 8, 210, 243, 10, BS_TOP | BS_MULTILINE
    AUTOCHECKBOX "&Siirrä toimiva numero luettelon alkuun", 1010, 8, 228, 243, 10, BS_TOP | BS_MULTILINE
    DEFPUSHBUTTON "OK", 1, 122, 245, 60, 14
    PUSHBUTTON "Peruuta", 2, 188, 245, 60, 14
END

