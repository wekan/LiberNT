    LTEXT "Valitse valintaruutu jokaisen käyttäjän kohdalla, jolle sallitaan yhteys tähän tietokoneeseen. Huomaa, että muut tekijät, kuten käytöstä poistettu käyttäjätili, voivat vaikuttaa käyttäjän mahdollisuuteen muodostaa yhteys.", -1, 10, 1, 275, 27
    LTEXT "&Käyttäjät, joilla on yhteyslupa:", -1, 10, 28, 275, 8
    CONTROL "", 7043, "SYSLISTVIEW32", WS_BORDER | WS_GROUP | WS_TABSTOP | 0x0000440D, 10, 42, 275, 73
    PUSHBUTTON "&Lisää...", 7044, 10, 122, 65, 14, WS_GROUP
    PUSHBUTTON "&Poista", 7045, 79, 122, 65, 14, WS_GROUP
    PUSHBUTTON "&Ominaisuudet", 7046, 147, 122, 65, 14, WS_GROUP
END

