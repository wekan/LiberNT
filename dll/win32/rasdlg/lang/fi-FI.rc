BEGIN
    LTEXT "Näennäiset yksityiset yhteydet tietokoneeseesi Internetin kautta ovat mahdollisia vain, jos tietokoneellasi on tunnettu nimi tai IP-osoite Internetissä.", -1, 10, 4, 290, 20
    AUTORADIOBUTTON "&Salli näennäiset yksityiset yhteydet", 7053, 29, 63, 265, 10, BS_TOP | BS_MULTILINE | WS_GROUP
    AUTORADIOBUTTON "&Älä salli näennäisiä yksityisiä yhteyksiä", 7054, 29, 78, 265, 10, BS_TOP | BS_MULTILINE | NOT WS_TABSTOP
