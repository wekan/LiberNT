    LTEXT "Yksi tai useampi lisälinja ei muodostanut yhteyttä.", 1033, 37, 8, 216, 20
    CONTROL "", 1032, "SYSLISTVIEW32", WS_BORDER | WS_TABSTOP | 0x00008401, 37, 83, 224, 136
    AUTOCHECKBOX "&Älä yritä epäonnistuneita linjoja jatkossa", 1030, 38, 226, 222, 10
    DEFPUSHBUTTON "&Hyväksy", 1, 135, 242, 60, 14
    PUSHBUTTON "&Katkaise", 2, 201, 242, 60, 14
    LTEXT "Jos vain yksi linja muodosti yhteyden, palvelinta ei ehkä ole määritetty hyväksymään monilinjapuheluja. Valitse 'Älä yritä epäonnistuneita linjoja', jotta vältät tällöin tarpeettomat yhteysmaksut.", -1, 37, 36, 224, 44
END

105 DIALOGEX 0, 0, 261, 253
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
