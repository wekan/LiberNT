LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDR_BROWSE_MAIN_MENU MENU
{
    POPUP "&Tiedosto"
    {
        POPUP "&Uusi"
        {
            MENUITEM "&Ikkuna",                 ID_BROWSE_NEW_WINDOW
        }
        MENUITEM "&Avaa...",                    ID_BROWSE_OPEN
        MENUITEM "&Tallenna",                       ID_BROWSE_SAVE
        MENUITEM "Tallenna &nimellä...",                 ID_BROWSE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Sivun asetu&kset...",            ID_BROWSE_PRINT_FORMAT
        MENUITEM "Tul&osta...",                   ID_BROWSE_PRINT
        MENUITEM "&Esikatselu",              ID_BROWSE_PRINT_PREVIEW
        MENUITEM SEPARATOR
        MENUITEM "O&minaisuudet",                 ID_BROWSE_PROPERTIES
        MENUITEM "&Sulje",                      ID_BROWSE_QUIT
    }
    POPUP "&Näytä"
    {
        POPUP "&Työkalurivit"
        {
            MENUITEM "&Vakiopainikkeet",           ID_BROWSE_BAR_STD
            MENUITEM "&Osoiterivi",            ID_BROWSE_BAR_ADDR
        }
    }
    POPUP "&Suosikit"
    {
        MENUITEM "&Lisää suosikkeihin...",        ID_BROWSE_ADDFAV
        MENUITEM SEPARATOR
    }
    POPUP "&Ohje"
    {
        MENUITEM "&Tietoja: Internet Explorer", ID_BROWSE_ABOUT
    }
}

STRINGTABLE
{
    IDS_INTERNET "Internet-selain"
    IDS_INTERNET_DESCRIPTION "Avaa WWW-selaimen ja näyttää Internetin tietoja."

    IDS_TB_BACK             "Edellinen"
    IDS_TB_FORWARD          "Seuraava"
    IDS_TB_STOP             "Pysäytä"
    IDS_TB_REFRESH          "Päivitä"
    IDS_TB_HOME             "Aloitussivu"
    IDS_TB_PRINT            "Tulosta..."
}

STRINGTABLE
{
    IDS_ADDRESS             "Osoite"
}

STRINGTABLE
{
    IDS_FINDINGRESOURCE     "Etsitään: %s"
    IDS_BEGINDOWNLOADDATA   "Aloitetaan lataus: %s"
    IDS_ENDDOWNLOADDATA     "Ladataan: %s"
    IDS_SENDINGREQUEST      "Pyydetään: %s"
}


IDD_BROWSE_OPEN DIALOGEX 10, 10, 200, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_CAPTION
CAPTION "Avaa URL-osoite"
FONT 8, "MS Shell Dlg"
{
    LTEXT "Kirjoita URL-osoite, jonka haluat avata Internet Explorerissa",-1, 35,5,160,25
    LTEXT "Avaa:", -1, 5, 32, 30, 15
#ifdef __REACTOS__
    ICON IDC_PAGEICO, IDC_PAGEICO, 2, 5, 21, 20, SS_ICON
#endif
    EDITTEXT IDC_BROWSE_OPEN_URL, 35, 30, 160, 13
    DEFPUSHBUTTON "OK", IDOK, 90, 50, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 145, 50, 50, 14
}

#ifdef __REACTOS__
STRINGTABLE
{
    IDS_INTSHCUT_OPEN           "&Avaa"
    IDS_INTSHCUT_NEWNAME        "Uusi Internet-pikakuvake"
    IDS_INTSHCUT_RUN_NORMAL     "Normaali ikkuna"
    IDS_INTSHCUT_RUN_MINIMIZED  "Pienennetty"
    IDS_INTSHCUT_RUN_MAXIMIZED  "Suurennettu"
    IDS_INTSHCUT_OPEN_HELP      "Avaa tämän sivun."
    IDS_COMMBAND_REFRESH        "&Päivitä"
    IDS_COMMBAND_OPENWINDOW     "Avaa &ikkunassa"
    IDS_INTERNET_FOLDER         "Internet"
}

IDD_INTSHCUT_PROP DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "WWW-tiedosto"
FONT 8, "MS Shell Dlg"
{
    ICON "", IDC_INTSHCUT_ICON, 8, 8, 21, 20
    EDITTEXT IDC_INTSHCUT_NAME, 44, 12, 200, 12, ES_READONLY | ES_AUTOHSCROLL | NOT WS_BORDER | NOT WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 8, 35, 236, 1
    LTEXT "&URL:", -1, 8, 46, 60, 10
    EDITTEXT IDC_INTSHCUT_URL, 72, 44, 172, 12, ES_AUTOHSCROLL
    LTEXT "&Pikanäppäin:", -1, 8, 64, 60, 10
    CONTROL "", IDC_INTSHCUT_HOTKEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 72, 62, 172, 12
    LTEXT "&Suorita:", -1, 8, 82, 60, 10
    COMBOBOX IDC_INTSHCUT_SHOWCMD, 72, 80, 172, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", -1, "Static", SS_ETCHEDHORZ, 8, 102, 236, 1
    PUSHBUTTON "&Vaihda kuvake...", IDC_INTSHCUT_CHANGEICON, 72, 110, 70, 14
}
#endif
