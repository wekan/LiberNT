END


/*
 This code relates to the device manager GUI
 */

IDM_MAINMENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Lopeta",                       IDM_EXIT
    END
    POPUP "To&iminto"
    BEGIN
        MENUITEM "Etsi laitteistomuutoksia",   IDM_SCAN_HARDWARE
        MENUITEM "Lisää laitteisto",                IDM_ADD_HARDWARE
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Laitteet tyypin mukaan",             IDM_DEVBYTYPE
        MENUITEM "La&itteet yhteyden mukaan",       IDM_DEVBYCONN
        MENUITEM "&Resurssit tyypin mukaan",           IDM_RESBYTYPE
        MENUITEM "R&esurssit yhteyden mukaan",     IDM_RESBYCONN, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Näytä piilotetut laitteet",         IDM_SHOWHIDDEN
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Tietoja",                       IDM_ABOUT
    END
END


