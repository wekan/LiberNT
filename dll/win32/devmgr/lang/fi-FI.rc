/* error messages, source: http://www.z123.org/techsupport/medm.htm */
STRINGTABLE
BEGIN
    IDS_DEV_NO_PROBLEM "Tämä laite toimii oikein."
    IDS_DEV_NOT_CONFIGURED "Tätä laitetta ei ole määritetty oikein."
    IDS_DEV_DEVLOADER_FAILED "LiberNT ei voinut ladata tämän laitteen ohjainta, koska tietokone ilmoittaa kaksi %1-väylätyyppiä."
    IDS_DEV_DEVLOADER_FAILED2 "Tämän laitteen %1-laitelataajat eivät voineet ladata laiteohjainta."
    IDS_DEV_OUT_OF_MEMORY "Tämän laitteen ohjain voi olla viallinen, tai järjestelmän muisti tai muut resurssit voivat olla vähissä."
    IDS_DEV_ENTRY_IS_WRONG_TYPE "Tämä laite ei toimi oikein, koska jokin sen ohjaimista tai rekisteri voi olla viallinen."
    IDS_DEV_LACKED_ARBITRATOR "Tämän laitteen ohjain pyysi resurssia, jota LiberNT ei osaa käsitellä."
    IDS_DEV_BOOT_CONFIG_CONFLICT "Toinen laite käyttää resursseja, joita tämä laite tarvitsee."
    IDS_DEV_FAILED_FILTER "Tämän laitteen ohjaimet on asennettava uudelleen."
    IDS_DEV_DEVLOADER_NOT_FOUND "Tämä laite ei toimi oikein, koska LiberNT ei voi ladata tiedostoa %1, joka lataa laitteen ohjaimet."
    IDS_DEV_DEVLOADER_NOT_FOUND2 "Tämä laite ei toimi oikein, koska tiedosto %1, joka lataa tämän laitteen ohjaimet, on viallinen."
    IDS_DEV_DEVLOADER_NOT_FOUND3 "Laitevika: Yritä vaihtaa tämän laitteen ohjain. Jos se ei auta, katso laitteiston ohjeista."
    IDS_DEV_INVALID_DATA "Tämä laite ei toimi oikein, koska tietokoneen BIOS ilmoittaa laitteen resurssit väärin."
    IDS_DEV_INVALID_DATA2 "Tämä laite ei toimi oikein, koska laitteen BIOS ilmoittaa laitteen resurssit väärin. "
    IDS_DEV_FAILED_START "Tämä laite ei ole läsnä, ei toimi oikein, tai sen kaikkia ohjaimia ei ole asennettu."
    IDS_DEV_LIAR "LiberNT lakkasi vastaamasta yrittäessään käynnistää tämän laitteen, eikä siksi yritä käynnistää tätä laitetta enää uudelleen."
    IDS_DEV_NORMAL_CONFLICT "Tämä laite ei löydä käytettäväksi yhtään vapaata %1-resurssia."
    IDS_DEV_NOT_VERIFIED "Tämä laite ei ole läsnä, ei toimi oikein, tai sen kaikkia ohjaimia ei ole asennettu."
    IDS_DEV_NEED_RESTART "Tämä laite ei voi toimia oikein, ennen kuin käynnistät tietokoneen uudelleen."
    IDS_DEV_REENUMERATION "Tämä laite aiheuttaa resurssiristiriidan."
    IDS_DEV_PARTIAL_LOG_CONF "LiberNT ei voinut tunnistaa kaikkia tämän laitteen käyttämiä resursseja."
    IDS_DEV_UNKNOWN_RESOURCE "Ohjaimen tietotiedosto %1 käskee tätä alilaitetta käyttämään resurssia, jota ylälaitteella ei ole tai jota se ei tunnista."
    IDS_DEV_REINSTALL "Tämän laitteen ohjaimet on asennettava uudelleen."
    IDS_DEV_REGISTRY "Rekisteri voi olla viallinen."
    IDS_DEV_WILL_BE_REMOVED "LiberNT poistaa tätä laitetta."
    IDS_DEV_DISABLED "Tätä laitetta ei ole käynnistetty."
    IDS_DEV_DISABLED2 "Tämä laite on poistettu käytöstä."
    IDS_DEV_DEVLOADER_NOT_READY "Tämän laitteen lataajat eivät voi ladata tarvittavia ohjaimia."
    IDS_DEV_DEVLOADER_NOT_READY2 "" /* unused */
    IDS_DEV_DEVLOADER_NOT_READY3 "" /* unused */
    IDS_DEV_DEVICE_NOT_THERE "Tämä laite ei ole läsnä, ei toimi oikein, tai sen kaikkia ohjaimia ei ole asennettu."
    IDS_DEV_MOVED "LiberNT on määrittämässä tätä laitetta."
    IDS_DEV_TOO_EARLY "LiberNT on määrittämässä tätä laitetta."
    IDS_DEV_NO_VALID_LOG_CONF "LiberNT ei voi määrittää tämän laitteen resursseja."
    IDS_DEV_FAILED_INSTALL "Tämän laitteen ohjaimia ei ole asennettu."
    IDS_DEV_HARDWARE_DISABLED "Tämä laite on poistettu käytöstä, koska laitteen BIOS ei antanut sille resursseja."
    IDS_DEV_CANT_SHARE_IRQ "Tämä laite käyttää keskeytyspyyntöresurssia (IRQ), jota toinen laite käyttää ja jota ei voi jakaa.\nMuuta ristiriitainen asetus tai poista ristiriidan aiheuttava reaalitilan ohjain."
    IDS_DEV_FAILED_ADD "Tämä laite ei toimi oikein, koska LiberNT ei voi ladata laitteen tarvitsemia ohjaimia."
    IDS_DEV_DISABLED_SERVICE "LiberNT ei voi asentaa tämän laitteen ohjaimia, koska se ei pääse asemaan tai verkkosijaintiin, jossa asennustiedostot ovat."
    IDS_DEV_TRANSLATION_FAILED "Tämä laite ei vastaa ohjaimelleen."
    IDS_DEV_NO_SOFTCONFIG "LiberNT ei voi selvittää tämän laitteen asetuksia. Katso laitteen mukana tulleita ohjeita ja määritä asetukset Resurssit-välilehdellä."
    IDS_DEV_BIOS_TABLE "Tietokoneen järjestelmän laiteohjelmisto ei sisällä riittävästi tietoja tämän laitteen määrittämiseen ja käyttämiseen.\nJos haluat käyttää tätä laitetta, hanki laiteohjelmisto- tai BIOS-päivitys tietokoneen valmistajalta."
    IDS_DEV_IRQ_TRANSLATION_FAILED "Tämä laite pyytää PCI-keskeytystä, mutta se on määritetty ISA-keskeytykselle (tai päinvastoin).\nMääritä laitteen keskeytys uudelleen tietokoneen järjestelmän asetusohjelmalla."
    IDS_DEV_FAILED_DRIVER_ENTRY "LiberNT ei voi alustaa tämän laitteiston laiteohjainta."
    IDS_DEV_DRIVER_FAILED_PRIOR_UNLOAD "LiberNT ei voi ladata tämän laitteiston laiteohjainta, koska laiteohjaimen aiempi esiintymä on yhä muistissa."
    IDS_DEV_DRIVER_FAILED_LOAD "LiberNT ei voi ladata tämän laitteiston laiteohjainta. Ohjain voi olla vioittunut tai puuttua."
    IDS_DEV_DRIVER_SERVICE_KEY_INVALID "LiberNT ei pääse käyttämään tätä laitteistoa, koska sen palveluavaimen tiedot puuttuvat rekisteristä tai ne on tallennettu väärin."
    IDS_DEV_LEGACY_SERVICE_NO_DEVICES "LiberNT latasi tämän laitteiston laiteohjaimen, mutta ei löydä laitetta."
    IDS_DEV_DUPLICATE_DEVICE "LiberNT ei voi ladata tämän laitteiston laiteohjainta, koska järjestelmässä on jo käynnissä samanlainen laite."
    IDS_DEV_FAILED_POST_START "LiberNT on pysäyttänyt tämän laitteen, koska se on ilmoittanut ongelmista."
    IDS_DEV_HALTED "Sovellus tai palvelu on sammuttanut tämän laitteen."
    IDS_DEV_PHANTOM "Tätä laitetta ei ole tällä hetkellä liitetty tietokoneeseen."
    IDS_DEV_SYSTEM_SHUTDOWN "LiberNT ei pääse käyttämään tätä laitetta, koska käyttöjärjestelmä on sammumassa."
    IDS_DEV_HELD_FOR_EJECT "LiberNT ei voi käyttää tätä laitetta, koska se on valmisteltu turvallista poistamista varten, mutta sitä ei ole irrotettu tietokoneesta"
    IDS_DEV_DRIVER_BLOCKED "Tämän laitteen ohjelmiston käynnistyminen on estetty, koska sillä tiedetään olevan ongelmia LiberNT:n kanssa. Pyydä uusi ohjain laitteiston toimittajalta."
    IDS_DEV_REGISTRY_TOO_LARGE "LiberNT ei voi käynnistää uusia laitteita, koska järjestelmän rekisteriryhmä on liian suuri (ylittää rekisterin kokorajoituksen)."
    IDS_DEV_SETPROPERTIES_FAILED "LiberNT ei pystynyt muuttamaan tämän laitteen asetuksia."
END

