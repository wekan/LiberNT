IDD_TCPIP_ADVIP_DLG DIALOGEX 0, 0, 247, 220
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "IP-asetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "IP-o&soitteet", -1, 5, 5, 240, 83
    CONTROL "", IDC_IPLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 15, 15, 215, 50
    PUSHBUTTON "&Lisää...", IDC_IPADD, 60, 67, 50, 14
    PUSHBUTTON "&Muokkaa...", IDC_IPMOD, 120, 67, 50, 14
    PUSHBUTTON "&Poista", IDC_IPDEL, 180, 67, 50, 14
    GROUPBOX "&Oletusyhdyskäytävät:", -1, 5, 93, 240, 83
    CONTROL "", IDC_GWLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 15, 103, 215, 50
    PUSHBUTTON "L&isää...", IDC_GWADD, 60, 155, 50, 14
    PUSHBUTTON "Muo&kkaa...", IDC_GWMOD, 120, 155, 50, 14
    PUSHBUTTON "Poist&a", IDC_GWDEL, 180, 155, 50, 14
    GROUPBOX "", -1, 5, 181, 240, 30
    CHECKBOX "A&utomaattinen metriikka", IDC_IFAUTOMETRIC, 9, 179, 90, 12, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT "Liitt&ymän metriikka:", -1, 15, 195, 90, 12
    EDITTEXT IDC_IFMETRIC, 110, 193, 50, 12, WS_TABSTOP | ES_NUMBER
END

IDD_TCPIP_ADVDNS_DLG DIALOGEX 0, 0, 247, 220
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "DNS"
FONT 8, "MS Shell Dlg"
BEGIN
    LISTBOX IDC_DNSADDRLIST, 5, 17, 180, 34, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT
    LTEXT "&DNS-palvelinten osoitteet käyttöjärjestyksessä:", -1, 5, 5, 180, 12
    PUSHBUTTON "Ylös", IDC_DNSADDRUP, 190, 18, 50, 14
    PUSHBUTTON "Alas", IDC_DNSADDRDOWN, 190, 35, 50, 14
    PUSHBUTTON "&Lisää...", IDC_DNSADDRADD, 15, 53, 50, 14
    PUSHBUTTON "&Muokkaa...", IDC_DNSADDRMOD, 75, 53, 50, 14
    PUSHBUTTON "&Poista", IDC_DNSADDRDEL, 135, 53, 50, 14
    LTEXT "Seuraavat kolme asetusta koskevat kaikkia yhteyksiä, joissa TCP/IP on käytössä. Ratkaistaessa tarkentamattomia nimiä:", -1, 5, 70, 220, 24
    CONTROL "Liitä &ensisijaiset ja yhteyskohtaiset DNS-liitteet", IDC_PRIMSUFFIX, "BUTTON", BS_AUTORADIOBUTTON, 5, 90, 220, 12
    CHECKBOX "Liitä ensisijaisen DNS-liitteen &ylätason liitteet", IDC_TOPPRIMSUFFIX, 15, 102, 220, 12, BS_AUTOCHECKBOX | WS_TABSTOP
    CONTROL "Liitä &nämä DNS-liitteet (järjestyksessä):", IDC_SELSUFFIX, "BUTTON", BS_AUTORADIOBUTTON, 5, 115, 220, 12
    LISTBOX IDC_DNSSUFFIXLIST, 5, 127, 180, 34, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT
    PUSHBUTTON "Ylös", IDC_DNSSUFFIXUP, 190, 128, 50, 14
    PUSHBUTTON "Alas", IDC_DNSSUFFIXDOWN, 190, 145, 50, 14
    PUSHBUTTON "&Lisää...", IDC_DNSSUFFIXADD, 15, 163, 50, 14
    PUSHBUTTON "&Muokkaa...", IDC_DNSSUFFIXMOD, 75, 163, 50, 14
    PUSHBUTTON "&Poista", IDC_DNSSUFFIXDEL, 135, 163, 50, 14
    LTEXT "Tämän yhteyden DNS-lii&te:", -1, 5, 183, 110, 14
    EDITTEXT IDC_SUFFIX, 120, 180, 100, 12, WS_TABSTOP
    CHECKBOX "&Rekisteröi tämän yhteyden osoitteet DNS:ään", IDC_REGSUFFIX, 15, 195, 190, 12, BS_AUTOCHECKBOX | WS_TABSTOP
    CHECKBOX "&Käytä tämän yhteyden DNS-liitettä DNS-rekisteröinnissä", IDC_USESUFFIX, 15, 207, 227, 12, BS_AUTOCHECKBOX | WS_TABSTOP
END

