LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_TCPIP_BASIC_DLG DIALOGEX 0, 0, 246, 216
STYLE DS_SHELLFONT | WS_CHILD | WS_CAPTION
CAPTION "Yleiset"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Voit saada IP-asetukset automaattisesti, jos verkko tukee tätä ominaisuutta. Muussa tapauksessa pyydä verkon järjestelmänvalvojalta oikeat IP-asetukset.", -1, 9, 9, 235, 27
    GROUPBOX "", -1, 9, 61, 228, 60, BS_GROUPBOX
    CONTROL "&Hae IP-osoite automaattisesti", IDC_USEDHCP, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 43, 210, 12
    CONTROL "&Käytä seuraavaa IP-osoitetta:", IDC_NODHCP, "BUTTON", BS_AUTORADIOBUTTON, 14, 59, 120, 12
    LTEXT "&IP-osoite:", -1, 14, 75, 135, 8
    CONTROL "", IDC_IPADDR, "SysIPAddress32", WS_TABSTOP, 144, 75 - 2, 85, 12
    LTEXT "&Aliverkon peite:", -1, 14, 90, 135, 8
    CONTROL "", IDC_SUBNETMASK, "SysIPAddress32", WS_TABSTOP, 144, 90 - 2, 85, 12
    LTEXT "&Oletusyhdyskäytävä:", -1, 14, 105, 135, 8
    CONTROL "", IDC_DEFGATEWAY, "SysIPAddress32", WS_TABSTOP, 144, 105 - 2, 85, 12
    GROUPBOX "", -1, 9, 147, 228, 47, BS_GROUPBOX
    CONTROL "Hae &DNS-palvelimen osoite automaattisesti", IDC_AUTODNS, "BUTTON", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 14, 129, 210, 12
    CONTROL "Käy&tä seuraavia DNS-palvelinten osoitteita:", IDC_FIXEDDNS, "BUTTON", BS_AUTORADIOBUTTON, 14, 145, 152, 12
    LTEXT "&Ensisijainen DNS-palvelin:", -1, 14, 161, 135, 8
    CONTROL "", IDC_DNS1, "SysIPAddress32", WS_TABSTOP, 144, 161 - 2, 85, 12
    LTEXT "&Vaihtoehtoinen DNS-palvelin:", -1, 14, 176, 135, 8
    CONTROL "", IDC_DNS2, "SysIPAddress32", WS_TABSTOP, 144, 176 - 2, 85, 12
    PUSHBUTTON "&Lisäasetukset", IDC_ADVANCED, 186, 199, 50, 14
END

