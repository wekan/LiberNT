LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_SERIALSETTINGS DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Portin asetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    RTEXT "&Bittiä sekunnissa:", -1, 6, 19, 130, 8, WS_GROUP
    COMBOBOX IDC_SERIAL_BITSPERSECOND, 139, 17, 106, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    RTEXT "&Databitit:", -1, 6, 40, 130, 8, WS_GROUP
    COMBOBOX IDC_SERIAL_DATABITS, 139, 38, 106, 54, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    RTEXT "&Pariteetti:", -1, 6, 61, 130, 8, WS_GROUP
    COMBOBOX IDC_SERIAL_PARITY, 139, 59, 106, 62, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    RTEXT "&Stop-bitit:", -1, 6, 82, 130, 8, WS_GROUP
    COMBOBOX IDC_SERIAL_STOPBITS, 139, 80, 106, 54, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    RTEXT "&Vuonohjaus:", -1, 6, 102, 130, 8, WS_GROUP
    COMBOBOX IDC_SERIAL_FLOWCONTROL, 139, 100, 106, 54, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    PUSHBUTTON "&Lisäasetukset...", IDC_SERIAL_ADVANCED, 71, 130, 85, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON "Palauta &oletukset", IDC_SERIAL_RESTORE, 160, 130, 85, 14, WS_GROUP | WS_TABSTOP
END

IDD_PARALLELSETTINGS DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Portin asetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Resurssien suodatustapa", -1, 6, 6, 237, 75
    AUTORADIOBUTTON "Yritä olla käyttämättä keskeytystä", IDC_TRY_INTERRUPT, 11, 22, 227, 10, WS_GROUP
    AUTORADIOBUTTON "Älä koskaan käytä keskeytystä", IDC_NEVER_INTERRUPT, 11, 44, 227, 10
    AUTORADIOBUTTON "Käytä mitä tahansa portille määritettyä keskeytystä", IDC_ANY_INTERRUPT, 11, 66, 227, 10
    AUTOCHECKBOX "Ota käyttöön vanha Plug and Play -tunnistus", IDC_PARALLEL_LEGACY, 6, 90, 237, 10, WS_TABSTOP
    LTEXT "LPT-portin numero:", -1, 6, 107, 140, 10, WS_GROUP
    COMBOBOX IDC_PARALLEL_NAME, 65, 105, 75, 20, CBS_DROPDOWNLIST | WS_GROUP | WS_TABSTOP | WS_VSCROLL
END

STRINGTABLE
BEGIN
    IDS_PARITY "Parillinen,Pariton,Ei mitään,Merkki,Väli"
    IDS_STOPBITS "1,1.5,2"
    IDS_FLOWCONTROL "Xon / Xoff,Laitteisto,Ei mitään"
    IDS_PORT_IN_USE " (käytössä)"
END
