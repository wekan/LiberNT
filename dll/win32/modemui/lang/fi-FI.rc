LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDM_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Monista...", 0
        MENUITEM "&Poista", 1
        MENUITEM "&Näytä loki", 2
        MENUITEM SEPARATOR
        MENUITEM "&Ominaisuudet", 3
        MENUITEM "&Kopioi ominaisuudet", 4
        MENUITEM "Kä&ytä ominaisuuksia", 5
    END
END

