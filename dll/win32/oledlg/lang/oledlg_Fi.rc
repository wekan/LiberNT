LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
{
  IDS_RESULTOBJDESC	"Lisää uusi %s-objekti asiakirjaan"
  IDS_RESULTFILEOBJDESC	"Lisää tiedoston sisältö objektina asiakirjaan, jotta voit aktivoida sen ohjelmalla, jolla se on luotu."
  IDS_BROWSE            "Selaa"
  IDS_NOTOLEMOD         "Tiedosto ei näytä olevan kelvollinen OLE-moduuli. OLE-komponenttia ei voi rekisteröidä."
  IDS_NOTOLEMODCAPTION  "Lisää komponentti"
  IDS_VERBMENU_OBJECT   "&Objekti"
  IDS_VERBMENU_OBJECT_WITH_NAME "%1 &objekti"
  IDS_VERBMENU_CONVERT  "&Muunna..."
  IDS_VERBMENU_SINGLEVERB_OBJECT "%1 %2 &objekti"
}

STRINGTABLE
{
    IDS_PS_PASTE_DATA                     "Lisää leikepöydän sisällön asiakirjaan muodossa %s."
    IDS_PS_PASTE_OBJECT                   "Lisää leikepöydän sisällön asiakirjaan, jotta voit aktivoida sen ohjelmalla %s."
    IDS_PS_PASTE_OBJECT_AS_ICON           "Lisää leikepöydän sisällön asiakirjaan, jotta voit aktivoida sen ohjelmalla %s. Se näytetään kuvakkeena."
    IDS_PS_PASTE_LINK_DATA                "Lisää leikepöydän sisällön asiakirjaan muodossa %s. Tiedot on linkitetty lähdetiedostoon, joten tiedostoon tehdyt muutokset näkyvät asiakirjassa."
    IDS_PS_PASTE_LINK_OBJECT              "Lisää kuvan leikepöydän sisällöstä asiakirjaan. Kuva on linkitetty lähdetiedostoon, joten tiedostoon tehdyt muutokset näkyvät asiakirjassa."
    IDS_PS_PASTE_LINK_OBJECT_AS_ICON      "Lisää pikakuvakkeen, joka osoittaa leikepöydän sisällön sijaintiin. Pikakuvake on linkitetty lähdetiedostoon, joten tiedostoon tehdyt muutokset näkyvät asiakirjassa."
    IDS_PS_NON_OLE                        "Lisää leikepöydän sisällön asiakirjaan."
    IDS_PS_UNKNOWN_TYPE                   "Tuntematon tyyppi"
    IDS_PS_UNKNOWN_SRC                    "Tuntematon lähde"
    IDS_PS_UNKNOWN_APP                    "ohjelma, jolla se on luotu"
}

UIINSERTOBJECT DIALOGEX  0, 0, 304, 151
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lisää objekti"
FONT 8, "MS Shell Dlg"
BEGIN
    LISTBOX         IDC_OBJTYPELIST,92,19,131,66,LBS_SORT |
                    LBS_NOINTEGRALHEIGHT | WS_VISIBLE | WS_VSCROLL |
                    WS_TABSTOP
    LTEXT           "Objektityyppi:",IDC_OBJTYPELBL,92,7,53,8,WS_VISIBLE
    DEFPUSHBUTTON   "OK",IDOK,231,7,66,14
    PUSHBUTTON      "Peruuta",IDCANCEL,231,24,66,14
    GROUPBOX        "Tulos",IDC_RESULT,7,103,218,41
    CONTROL         "Luo uusi",IDC_CREATENEW,"Button",BS_AUTORADIOBUTTON |
                    WS_GROUP,7,20,84,10
    CONTROL         "Luo komponentti",IDC_CREATECONTROL,"Button",
                    BS_AUTORADIOBUTTON | NOT WS_VISIBLE,7,54,84,10
    CONTROL         "Luo tiedostosta",IDC_CREATEFROMFILE,"Button",
                    BS_AUTORADIOBUTTON,7,37,84,10
    LTEXT           "",IDC_RESULTDESC,49,112,169,26
    PUSHBUTTON      "&Lisää komponentti...",IDC_ADDCONTROL,92,88,80,14,NOT WS_VISIBLE
    CONTROL         "Näytä kuvakkeena",IDC_ASICON,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP | NOT WS_VISIBLE,92,88,120,10
    PUSHBUTTON      "Selaa...",IDC_BROWSE,92,53,50,14,NOT WS_VISIBLE
    LTEXT           "Tiedosto:",IDC_FILELBL,92,27,20,8, NOT WS_VISIBLE
    EDITTEXT        IDC_FILE,92,37,132,13,ES_AUTOHSCROLL | NOT WS_VISIBLE
END

IDD_PASTESPECIAL4 DIALOGEX 3, 15, 304, 160
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Liitä määräten"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT         "Lähde:", -1, 6, 9, 150, 8, WS_VISIBLE | WS_GROUP
    CONTROL       "&Liitä", IDC_PS_PASTE, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP | WS_GROUP | WS_VISIBLE,
                  6, 38, 73, 10
    CONTROL       "Liitä li&nkki", IDC_PS_PASTELINK, "Button", BS_AUTORADIOBUTTON | WS_VISIBLE,
                  6, 63, 73, 10
    LTEXT         "&Muodossa:", -1, 75, 25, 150, 8, WS_VISIBLE | WS_GROUP
    LISTBOX       IDC_PS_PASTELIST,     80, 36, 148, 57, LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_BORDER | NOT WS_VISIBLE
    LISTBOX       IDC_PS_PASTELINKLIST, 80, 36, 148, 57, LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_BORDER | NOT WS_VISIBLE
    LISTBOX       IDC_PS_DISPLAYLIST,   80, 36, 148, 57, LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_BORDER | WS_VISIBLE
    CONTROL       "OK", IDOK, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_GROUP | WS_VISIBLE, 234, 6, 66, 14
    CONTROL       "Peruuta", IDCANCEL, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_VISIBLE, 234, 23, 66, 14
    CONTROL       "&Ohje", IDC_OLEUIHELP, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_VISIBLE, 234, 42, 66, 14
    CONTROL       "Näytä &kuvakkeena", IDC_PS_DISPLAYASICON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_VISIBLE, 80, 94, 150, 14
    CONTROL       "", IDC_PS_ICONDISPLAY, "Static", SS_ICON | WS_VISIBLE, 234, 75, 66, 44
    CONTROL       "Vaihda k&uvake...", IDC_PS_CHANGEICON, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_VISIBLE, 234, 143, 66, 14
    CONTROL       "", IDC_PS_RESULTIMAGE, "Static", SS_ICON | WS_VISIBLE, 8, 121, 42, 34
    CONTROL       "", IDC_PS_RESULTTEXT, "Static", SS_NOPREFIX | WS_VISIBLE, 54, 120, 159, 35
    CONTROL       "Tulos", -1, "Button", BS_GROUPBOX | WS_GROUP | WS_VISIBLE, 6, 110, 212, 48
    CONTROL       "", IDC_PS_SOURCETEXT, "Edit", ES_READONLY | ES_AUTOHSCROLL | WS_VISIBLE, 37, 9, 180, 8
END
