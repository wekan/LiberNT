LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

/* Menus */

IDM_CABINET_CONTEXTMENU MENUEX
BEGIN
    POPUP "", 264,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Vakiopainikkeet", IDM_TOOLBARS_STANDARDBUTTONS, MFT_STRING, MFS_ENABLED
        MENUITEM "&Osoiterivi", IDM_TOOLBARS_ADDRESSBAR, MFT_STRING, MFS_ENABLED
        MENUITEM "&Linkit", IDM_TOOLBARS_LINKSBAR, MFT_STRING, MFS_ENABLED
        MENUITEM "", -1, MFT_SEPARATOR
        MENUITEM "Lukitse &työkalurivit", IDM_TOOLBARS_LOCKTOOLBARS, MFT_STRING, MFS_ENABLED
        MENUITEM "&Mukauta...", IDM_TOOLBARS_CUSTOMIZE, MFT_STRING, MFS_ENABLED
        MENUITEM "Te&kstiselitteet", IDM_TOOLBARS_TEXTLABELS, MFT_STRING, MFS_ENABLED
        MENUITEM "&Siirry-painike", IDM_TOOLBARS_GOBUTTON, MFT_STRING, MFS_ENABLED
    END
END

IDM_CABINET_MAINMENU MENUEX
BEGIN
    POPUP "&Tiedosto", FCIDM_MENU_FILE
    BEGIN
        MENUITEM "", -1, MFT_SEPARATOR
        MENUITEM "&Sulje", IDM_FILE_CLOSE
    END
    POPUP "&Muokkaa", FCIDM_MENU_EDIT
    BEGIN
        MENUITEM "", -1, MFT_SEPARATOR
    END
    POPUP "&Näytä", FCIDM_MENU_VIEW
    BEGIN
        POPUP "&Työkalurivit", IDM_VIEW_TOOLBARS
        BEGIN
            MENUITEM "", -1, MFT_SEPARATOR
        END
        MENUITEM "Tila&rivi", IDM_VIEW_STATUSBAR
        POPUP "R&esurssienhallinnan palkki", IDM_VIEW_EXPLORERBAR
        BEGIN
            MENUITEM "&Haku\tCtrl+E", IDM_EXPLORERBAR_SEARCH
            MENUITEM "&Suosikit\tCtrl+I", IDM_EXPLORERBAR_FAVORITES
            MENUITEM "&Media", IDM_EXPLORERBAR_MEDIA
            MENUITEM "His&toria\tCtrl+H", IDM_EXPLORERBAR_HISTORY
            MENUITEM "&Kansiot", IDM_EXPLORERBAR_FOLDERS
            MENUITEM "", IDM_EXPLORERBAR_SEPARATOR
        END
        MENUITEM "", FCIDM_MENU_VIEW_SEP_OPTIONS, MFT_SEPARATOR
        POPUP "&Siirry", FCIDM_MENU_EXPLORE
        BEGIN
            MENUITEM "&Edellinen\tAlt+Vasen nuoli", IDM_GOTO_BACK
            MENUITEM "&Seuraava\tAlt+Oikea nuoli", IDM_GOTO_FORWARD
            MENUITEM "&Ylös yksi taso", IDM_GOTO_UPONELEVEL
            MENUITEM "", -1, MFT_SEPARATOR
            MENUITEM "&Aloitussivu\tAlt+Home", IDM_GOTO_HOMEPAGE
        END
        MENUITEM "&Päivitä", IDM_VIEW_REFRESH
    END
    POPUP "S&uosikit", FCIDM_MENU_FAVORITES
    BEGIN
        MENUITEM "&Lisää suosikkeihin...", IDM_FAVORITES_ADDTOFAVORITES
        MENUITEM "&Järjestä suosikit...", IDM_FAVORITES_ORGANIZEFAVORITES
        MENUITEM "", -1, MFT_SEPARATOR
        MENUITEM "(Tyhjä)", IDM_FAVORITES_EMPTY
    END
    POPUP "T&yökalut", FCIDM_MENU_TOOLS
    BEGIN
        MENUITEM "Yhdistä &verkkoasema...", IDM_TOOLS_MAPNETWORKDRIVE
        MENUITEM "&Katkaise verkkoaseman yhteys...", IDM_TOOLS_DISCONNECTNETWORKDRIVE
        MENUITEM "&Synkronoi...", IDM_TOOLS_SYNCHRONIZE
        MENUITEM "", -1, MFT_SEPARATOR
        MENUITEM "Kansio&asetukset...", IDM_TOOLS_FOLDEROPTIONS
    END
    POPUP "&Ohje", FCIDM_MENU_HELP
    BEGIN
        MENUITEM "&Tietoja LiberNT:stä", IDM_HELP_ABOUT
    END
END

IDM_TASKBAR_TOOLBARS MENUEX
BEGIN
    POPUP "&Työkalurivit", -1, MFT_STRING, MFS_ENABLED, 0
    BEGIN
        MENUITEM "&Työpöytä", IDM_TASKBAR_TOOLBARS_DESKTOP, MFT_STRING
        MENUITEM "&Pikakäynnistys", IDM_TASKBAR_TOOLBARS_QUICKLAUNCH, MFT_STRING
        MENUITEM "", -1, MFT_SEPARATOR, MFS_ENABLED
        MENUITEM "&Uusi työkalurivi...", IDM_TASKBAR_TOOLBARS_NEW, MFT_STRING
    END
END

IDM_BAND_MENU MENUEX
BEGIN
    MENUITEM "&Näytä otsikko", IDM_BAND_TITLE
    MENUITEM "&Sulje työkalurivi", IDM_BAND_CLOSE
END

/* Dialogs */

IDD_PROGRESS_DLG DIALOGEX 0, 0, 260, 85
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION ""
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_ANIMATION, ANIMATE_CLASSA, 0, 12, 10, 236, 30 /* TODO: style */
    LTEXT "", IDC_TEXT_LINE,     7, 45, 250, 10, SS_LEFT|SS_NOPREFIX
    LTEXT "", IDC_TEXT_LINE + 1, 7, 55, 250, 10, SS_LEFT|SS_NOPREFIX
    LTEXT "", IDC_TEXT_LINE + 2, 7, 75, 190, 10, SS_LEFT|SS_NOPREFIX
    CONTROL "", IDC_PROGRESS_BAR, PROGRESS_CLASSA, WS_BORDER, 7, 65, 190, 8
    PUSHBUTTON "Peruuta", IDCANCEL, 205, 65, 50, 15, WS_GROUP | WS_TABSTOP | WS_VISIBLE
END

IDD_CUSTOMIZETOOLBAREX DIALOGEX 0, 0, 357, 33
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT "&Tekstiasetukset:", -1, 4, 2, 48, 15
    COMBOBOX IDC_TEXTOPTIONS, 52, 0, 123, 57, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "K&uvakeasetukset:", -1, 4, 20, 48, 15
    COMBOBOX IDC_ICONOPTIONS, 52, 18, 123, 57, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_SEARCH_DLG DIALOGEX 0, 0, 260, 85
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CAPTION | WS_DLGFRAME
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Hae minkä tahansa tai kaikkien alla olevien ehtojen perusteella.", IDC_SEARCH_LABEL, 4, 2, 120, 20

    LTEXT "Tiedostonimi tai sen &osa:", -1, 10, 25, 500, 10
    EDITTEXT IDC_SEARCH_FILENAME, 10, 35, 100, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP

    LTEXT "&Sana tai lause tiedostossa:", -1, 10, 50, 500, 10
    EDITTEXT IDC_SEARCH_QUERY, 10, 60, 100, 12, ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP

    LTEXT "Etsi &kohteesta:", -1, 10, 75, 500, 10
    CONTROL "", IDC_SEARCH_COMBOBOX, WC_COMBOBOXEXW, WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN | WS_TABSTOP | CCS_NODIVIDER | CCS_NOMOVEY, 10, 85, 200, 200

    DEFPUSHBUTTON "&Hae", IDC_SEARCH_BUTTON, 80, 110, 40, 15, WS_GROUP | WS_TABSTOP | WS_VISIBLE
    PUSHBUTTON "&Pysäytä", IDC_SEARCH_STOP_BUTTON, 80, 110, 40, 15, WS_GROUP | WS_TABSTOP

    AUTOCHECKBOX "Hae piilotetuista tiedostoista ja kansioista",
                 IDC_SEARCH_HIDDEN, 4, 130, 130, 8, WS_VISIBLE | WS_GROUP | WS_TABSTOP

    CONTROL "", IDC_PROGRESS_BAR, PROGRESS_CLASSA, WS_BORDER | PBS_MARQUEE, 10, 155, 200, 8
END

/* Accelerators */

IDR_ACCELERATORS ACCELERATORS
BEGIN
    VK_F5, IDM_VIEW_REFRESH, VIRTKEY, NOINVERT
    VK_F5, IDM_VIEW_REFRESH, VIRTKEY, CONTROL, NOINVERT
    "R", IDM_VIEW_REFRESH, VIRTKEY, CONTROL, NOINVERT
    VK_HOME, IDM_GOTO_HOMEPAGE, VIRTKEY, ALT, NOINVERT
    "D", IDM_FAVORITES_ADDTOFAVORITES, VIRTKEY, CONTROL, NOINVERT
    "B", IDM_FAVORITES_ORGANIZEFAVORITES, VIRTKEY, CONTROL, NOINVERT
    VK_LEFT, IDM_GOTO_BACK, VIRTKEY, ALT
    VK_RIGHT, IDM_GOTO_FORWARD, VIRTKEY, ALT
    VK_UP, IDM_GOTO_UPONELEVEL, VIRTKEY, ALT
    VK_BACK, 41010, NOINVERT, VIRTKEY
    "W", IDM_FILE_CLOSE, VIRTKEY, CONTROL, NOINVERT
    "E", IDM_EXPLORERBAR_SEARCH, VIRTKEY, CONTROL, NOINVERT
    "I", IDM_EXPLORERBAR_FAVORITES, VIRTKEY, CONTROL, NOINVERT
    "H", IDM_EXPLORERBAR_HISTORY, VIRTKEY, CONTROL, NOINVERT
    VK_F11, FCIDM_BROWSER_TOGGLEFULLSCREEN, VIRTKEY, NOINVERT
END

