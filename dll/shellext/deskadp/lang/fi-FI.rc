LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_DISPLAYADAPTER DIALOGEX 0, 0, 252, 226
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Näyttösovitin"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    GROUPBOX "Sovittimen tyyppi", -1, 7, 3, 237, 50
    ICON IDC_DESK_ADAPTER, IDC_DESK_ADAPTER, 13, 11, 21, 20, SS_ICON
    LTEXT "", IDC_ADAPTERNAME, 40, 17, 190, 20, SS_NOPREFIX
    PUSHBUTTON "&Ominaisuudet", IDC_ADAPTERPROPERTIES, 177, 33, 59, 14
    GROUPBOX "Sovittimen tiedot", -1, 7, 56, 237, 75
    LTEXT "Piirin tyyppi:", -1, 13, 68, 58, 8
    LTEXT "", IDC_CHIPTYPE, 77, 68, 164, 8, SS_NOPREFIX
    LTEXT "DAC-tyyppi:", -1, 13, 80, 58, 8
    LTEXT "", IDC_DACTYPE, 77, 80, 164, 8, SS_NOPREFIX
    LTEXT "Muistin koko:", -1, 13, 92, 58, 8
    LTEXT "", IDC_MEMORYSIZE, 77, 92, 164, 8, SS_NOPREFIX
    LTEXT "Sovittimen nimi:", -1, 13, 104, 58, 8
    LTEXT "", IDC_ADAPTERSTRING, 77, 104, 164, 8, SS_NOPREFIX
    LTEXT "BIOS-tiedot:", -1, 13, 116, 58, 8
    LTEXT "", IDC_BIOSINFORMATION, 77, 116, 164, 8, SS_NOPREFIX
    PUSHBUTTON "&Kaikki tilat...", IDC_LISTALLMODES, 7, 139, 75, 14
END

IDD_LISTALLMODES DIALOGEX 0, 0, 225, 135
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUPWINDOW | WS_VISIBLE | WS_DLGFRAME
CAPTION "Kaikki tilat"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 112, 115, 50, 15
    PUSHBUTTON "Peruuta", IDCANCEL, 167, 115, 50, 15
    GROUPBOX "Kelvolliset tilat", -1, 6, 7, 212, 98
    LISTBOX IDC_ALLVALIDMODES, 10, 20, 204, 87, LBS_NOTIFY | WS_VSCROLL
END

STRINGTABLE
BEGIN
    IDS_MODEFMT "%d x %d, %s, %s"
    IDS_DEFREFRESHRATE "Oletusvirkistystaajuus"
    IDES_REFRESHRATEFMT "%d hertsiä"
    IDS_4BPP "16 väriä"
    IDS_8BPP "256 väriä"
    IDS_15BPP "High Color (15-bittinen)"
    IDS_16BPP "High Color (16-bittinen)"
    IDS_24BPP "True Color (24-bittinen)"
    IDS_32BPP "True Color (32-bittinen)"
    IDS_NOTAVAIL "Ei käytettävissä"
END
