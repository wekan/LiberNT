LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_POWER_METER DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTEXTHELP
CAPTION "Virtamittari"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Virran tila", 1001, "Button", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 9, 20, 234, 189
    CONTROL "&Näytä kuvake aina tehtäväpalkissa.", 1002, "Button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 6, 6, 120, 10
    CONTROL "Näytä kunkin &akun tiedot.", 1003, "Button", BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 135, 6, 120, 8
    CONTROL "", 1000, "Static", SS_LEFT | WS_CHILD | WS_GROUP, 11, 29, 229, 178
END

STRINGTABLE
BEGIN
    //Power related strings
    IDS_PWR_PROPERTIES        "&Säädä virranhallinnan ominaisuuksia"
    IDS_PWR_METER             "&Avaa virtamittari"
    IDS_PWR_RUN               "shell32.dll,Control_RunDLL PowerCfg.cpl"
    IDS_PWR_PERCENT_REMAINING "%u%% jäljellä"
    IDS_PWR_CHARGING          "%u%%, latautuu"
    IDS_PWR_UNKNOWN_REMAINING "Jäljellä tuntematon määrä"
    IDS_PWR_AC "Verkkovirta"
    IDS_PWR_HOURS_REMAINING "%1!u!:%2!02u! tuntia (%3!u!%%) jäljellä"
    IDS_PWR_MINUTES_REMAINING "%1!u! min (%2!u!%%) jäljellä"
    IDS_PWR_FULLY_CHARGED "Täysin ladattu"

    //Hotplug related strings
    IDS_HOTPLUG_REMOVE_1 "Poista laite turvallisesti"
    IDS_HOTPLUG_REMOVE_2 "&Poista laite turvallisesti"
    IDS_HOTPLUG_REMOVE_3 "Poista %s turvallisesti"
    IDS_HOTPLUG_RUN "shell32.dll,Control_RunDLL hotplug.dll"
    IDS_HOTPLUG_COMMA ", "
    IDS_HOTPLUG_DRIVE " - Asema(%s)"
    IDS_HOTPLUG_DRIVES " - Asemat(%s)"
    IDS_HOTPLUG_A "A:"
    IDS_HOTPLUG_REQUIRES "Tämä laite edellyttää ""turvallista poistoa"""
    IDS_HOTPLUG_CLICK "Ennen kuin poistat tämän laitteen, napsauta tätä kuvaketta ja valitse poistettava laite."

    //Volume related strings
    IDS_VOL_VOLUME "Äänenvoimakkuus"
    IDS_VOL_ADJUST "&Säädä ääniominaisuuksia"
    IDS_VOL_OPEN "&Avaa äänenvoimakkuuden säätö"
    IDS_VOL_RUN "SNDVOL32.EXE"
    IDS_VOL_MUTED "Äänenvoimakkuus (mykistetty)"
    IDS_VOL_NODEVICE "Äänentoistolaitetta ei ole asennettu."

    //Keyboard-Mouse related strings
    IDS_KEYS_STICKY "Alas jäävät näppäimet"
    IDS_KEYS_MOUSE "Hiirinäppäimet"
    IDS_KEYS_FILTER "Suodatusnäppäimet"
    IDS_BT_DEVICES "Bluetooth-laitteet"
    IDS_BT_SHOW "Näytä Bluetooth-&laitteet"
    IDS_BT_SETTINGS "Avaa &asetukset"
END
