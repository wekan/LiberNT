LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_DISCONNECTDRIVES DIALOGEX 0, 0, 300, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Katkaise verkkoasemien yhteys"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Valitse verkkoasemat, joiden yhteyden haluat katkaista, ja valitse OK.", -1, 7, 7, 286, 8
    LTEXT "&Verkkoasemat:", -1, 7, 23, 286, 8
    CONTROL "", IDC_CONNECTEDDRIVELIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SORTASCENDING | LVS_SINGLESEL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 7, 31, 286, 140
    PUSHBUTTON "OK", ID_OK, 189, 179, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 243, 179, 50, 14
END

STRINGTABLE
BEGIN
    IDS_DIALOG_CAPTION "Katkaise verkkoaseman yhteys"
    IDS_DRIVE_LETTER "Aseman tunnus"
    IDS_NETWORK_PATH "Verkkopolku"
    IDS_NO_DRIVES "Sinulla ei ole verkkoasemia, joiden yhteyden voisi katkaista."
END
