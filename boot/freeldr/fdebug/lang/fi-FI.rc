LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

/* Menu */
IDC_FDEBUG MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Yhdistä", IDM_FILE_CONNECT
        MENUITEM "&Katkaise yhteys", IDM_FILE_DISCONNECT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Ty&hjennä näyttö", IDM_FILE_CLEARDISPLAY
        MENUITEM SEPARATOR
        MENUITEM "&Aloita tallennus", IDM_FILE_STARTCAPTURE
        MENUITEM "&Pysäytä tallennus", IDM_FILE_STOPCAPTURE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Paikallinen &kaiku", IDM_FILE_LOCALECHO
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", IDM_EXIT
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Tietoja...", IDM_ABOUT
    END
END

/* Accelerators */
IDC_FDEBUG ACCELERATORS
BEGIN
    VK_OEM_2, IDM_ABOUT, VIRTKEY, ALT //FIXME: ?/ US keyboard only
    VK_DIVIDE, IDM_ABOUT, VIRTKEY, ALT
END

/* Dialogs */

IDD_ABOUTBOX DIALOGEX 22, 17, 259, 210
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Tietoja: FreeLoader Debugger"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "FreeLoader Debugger\nCopyright (C) 2003\nby Brian Palmer (brianp@reactos.org)", IDC_STATIC, "Static", SS_LEFTNOWORDWRAP | WS_GROUP, 53, 28, 122, 26
    DEFPUSHBUTTON "OK", IDOK, 183, 189, 44, 14, WS_GROUP
    ICON IDI_FDEBUG, IDC_STATIC, 19, 30, 20, 20
    EDITTEXT IDC_LICENSE_EDIT, 53, 63, 174, 107, ES_MULTILINE | ES_READONLY | WS_VSCROLL
END

IDD_CONNECTION DIALOGEX 0, 0, 196, 100
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Yhteysasetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Anna COM-portti (esim. COM1):", IDC_STATIC, 7, 7, 108, 8
    EDITTEXT IDC_COMPORT, 7, 17, 182, 14, ES_AUTOHSCROLL
    LTEXT "Anna siirtonopeus (esim. 115200):", IDC_STATIC, 7, 38, 114, 8
    EDITTEXT IDC_BAUTRATE, 7, 48, 182, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 45, 79, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 100, 79, 50, 14
END

IDD_CAPTURE DIALOGEX 0, 0, 251, 95
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tallennustiedosto"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Tallennustiedoston nimi:", IDC_STATIC, 7, 17, 62, 8
    EDITTEXT IDC_CAPTUREFILENAME, 7, 26, 181, 14, ES_AUTOHSCROLL
    PUSHBUTTON "&Selaa", IDC_BROWSE, 194, 26, 50, 14
    DEFPUSHBUTTON "OK", IDOK, 139, 74, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 194, 74, 50, 14
END

/* String Tables */

STRINGTABLE
BEGIN
    IDS_APP_TITLE "FreeLoader Debugger"
    IDS_HELLO "Hei maailma!"
    IDC_FDEBUG "FDEBUG"
END

