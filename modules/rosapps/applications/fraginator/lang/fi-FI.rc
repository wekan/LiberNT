                    WS_BORDER,7,7,78,58
    LTEXT           "Valitse asema:",-1,78,40,73,8
    LTEXT           "Valitse toiminto:",-1,159,40,73,8
    CONTROL         "Progress1",IDC_PROGRESS,"msctls_progress32",WS_BORDER |
                    0x1,7,71,320,10
    CONTROL         "Static",IDC_STATUS,"Static",SS_LEFTNOWORDWRAP |
                    SS_SUNKEN | WS_GROUP,7,86,359,10
    LTEXT           "Olen apina, kuule huutoni",IDC_WISECRACKS,78,15,115,8
    LTEXT           "100.00%",IDC_PERCENT,337,71,30,8,0,WS_EX_RIGHT
    LTEXT           "Prosessin prioriteetti:",-1,241,40,73,8
END

