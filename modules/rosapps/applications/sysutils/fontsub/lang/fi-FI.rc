LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

1 MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Tuo...\tCtrl+O", ID_IMPORT
        MENUITEM "&Vie...\tCtrl+S", ID_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Lataa uudelleen rekisteristä\tCtrl+L", ID_RELOAD
        MENUITEM "&Päivitä rekisteri\tCtrl+U", ID_UPDATE_REGISTRY
        MENUITEM SEPARATOR
        MENUITEM "Avaa &Regeditissä", ID_OPEN_REGKEY
        MENUITEM SEPARATOR
        MENUITEM "L&opeta\tAlt+F4", ID_EXIT
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Uusi kohde\tCtrl+N", ID_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Muokkaa kohdetta\tEnter", ID_EDIT
        MENUITEM SEPARATOR
        MENUITEM "&Poista kohde\tDel", ID_DELETE
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Tietoja...", ID_ABOUT
    END
END

2 MENU
BEGIN
    POPUP "Popup"
    BEGIN
        MENUITEM "&Uusi kohde\tCtrl+N", ID_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Muokkaa kohdetta\tEnter", ID_EDIT
        MENUITEM SEPARATOR
        MENUITEM "&Poista kohde\tDel", ID_DELETE
    END
END

STRINGTABLE
BEGIN
    IDS_TITLE,          "Fonttien korvausmuokkain"
    IDS_FONTNAME,       "Fontin nimi"
    IDS_SUBSTITUTE,     "Korvaava"
    IDS_ENTERNAME,      "(Anna fontin nimi...)"
    IDS_IMPORT,         "Tuo"
    IDS_EXPORT,         "Vie"
    IDS_CANTIMPORT,     "Tuonti epäonnistui."
    IDS_CANTEXPORT,     "Vienti epäonnistui."
    IDS_INPFILTER,      "Rekisteritiedostot (*.reg)|*.reg|Kaikki tiedostot (*.*)|*.*|"
    IDS_OUTFILTER,      "Rekisteritiedostot (*.reg)|*.reg|"
    IDS_QUERYUPDATE,    "Korvaustietoja on muutettu. Päivitetäänkö rekisteri nyt?"
    IDS_ALREADYEXISTS,  "Sama nimi on jo olemassa."
    IDS_ENTERNAME2,     "Anna fontin nimi."
    IDS_QUERYDELETE,    "Haluatko varmasti poistaa tämän kohteen?"
    IDS_CANTOPENKEY,    "Rekisteriavainta ei voitu avata."
    IDS_REBOOTNOW,      "Rekisteri päivitettiin. Käynnistetäänkö järjestelmä uudelleen nyt?"
    IDS_ABOUT,          "FontSub (fonttien korvausmuokkain) versio 0.5\r\nTekijät: Katayama Hirofumi MZ ja ReactOS-tiimi\r\n\r\nTämä ohjelmisto on julkaistu CC0 1.0 -lisenssillä."
END

IDD_ADD DIALOGEX 0, 0, 315, 65
STYLE DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_CAPTION | WS_SYSMENU
CAPTION "Lisää korvauskohde"
FONT 10, "MS Shell Dlg"
BEGIN
    CONTROL "Fontin &nimi:", -1, "STATIC", SS_RIGHT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 5, 55, 15
    CONTROL "", cmb1, "ComboBoxEx32", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 70, 6, 120, 120
    CONTROL "", cmb3, "ComboBoxEx32", CBS_DROPDOWNLIST | WS_HSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 195, 6, 115, 120
    CONTROL "&Korvaava:", -1, "STATIC", SS_RIGHT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 25, 55, 15
    CONTROL "", cmb2, "ComboBoxEx32", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 70, 26, 120, 120
    CONTROL "", cmb4, "ComboBoxEx32", CBS_DROPDOWNLIST | WS_HSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 195, 26, 115, 120
    CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 175, 45, 60, 14
    CONTROL "Peruuta", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 240, 45, 60, 14
END

IDD_EDIT DIALOGEX 0, 0, 315, 65
STYLE DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_CAPTION | WS_SYSMENU
CAPTION "Muokkaa korvauskohdetta"
FONT 10, "MS Shell Dlg"
BEGIN
    CONTROL "Fontin &nimi:", -1, "STATIC", SS_RIGHT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 5, 55, 15
    CONTROL "", edt1, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_BORDER | WS_TABSTOP, 70, 6, 120, 14
    CONTROL "", cmb3, "ComboBoxEx32", CBS_DROPDOWNLIST | WS_HSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 195, 6, 115, 120
    CONTROL "&Korvaava:", -1, "STATIC", SS_RIGHT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 25, 55, 15
    CONTROL "", cmb2, "ComboBoxEx32", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 70, 26, 120, 120
    CONTROL "", cmb4, "ComboBoxEx32", CBS_DROPDOWNLIST | WS_HSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 195, 26, 115, 120
    CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 175, 45, 60, 14
    CONTROL "Peruuta", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 240, 45, 60, 14
    CONTROL "&Poista", psh1, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 45, 60, 14
END
