LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_ABOUT DIALOGEX 10, 10, 130, 62
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "Tietoja"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON           IDI_MAIN,                     IDC_STATIC, 10, 10, 20, 20
    LTEXT          "ReactOS VGA -fonttieditori",    IDC_STATIC, 37, 10, 93, 10
    LTEXT          "Copyright 2008 Colin Finck", IDC_STATIC, 37, 20, 93, 10
    DEFPUSHBUTTON  "OK",                         IDCANCEL,   40, 44, 55, 15
END

IDD_EDITGLYPH DIALOGEX 0, 0, 246, 197
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Muokkaa merkkiä"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_EDIT_GLYPH_TOOLBOX, TOOLBARCLASSNAMEA,          CCS_NODIVIDER | CCS_NORESIZE, 5, 5, 24, 82
    CONTROL "", IDC_EDIT_GLYPH_EDIT,    EDIT_GLYPH_EDIT_CLASSW,     0, 39, 5, 160, 160
    CONTROL "", IDC_EDIT_GLYPH_PREVIEW, EDIT_GLYPH_PREVIEW_CLASSW,  0, 209, 5, 32, 32

    DEFPUSHBUTTON "OK", IDOK, 48, 177, 70, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 125, 177, 70, 14
END

IDM_MAINMENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Uusi\tCtrl+N", ID_FILE_NEW
        MENUITEM "&Avaa...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "Sulje", ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Tallenna\tCtrl+S", ID_FILE_SAVE
        MENUITEM "Tallenna nimellä...", ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "Lopeta\tAlt+F4", ID_FILE_EXIT
    END

    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "Kopioi\tCtrl+C", ID_EDIT_COPY
        MENUITEM "Liitä\tCtrl+V", ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Muokkaa merkkiä...", ID_EDIT_GLYPH
    END

    POPUP "&Ikkuna"
    BEGIN
        MENUITEM "&Limittäin", ID_WINDOW_CASCADE
        MENUITEM "&Vaakasuunnassa vierekkäin", ID_WINDOW_TILE_HORZ
        MENUITEM "&Pystysuunnassa vierekkäin", ID_WINDOW_TILE_VERT
        MENUITEM "&Järjestä kuvakkeet", ID_WINDOW_ARRANGE
        MENUITEM SEPARATOR
        MENUITEM "&Seuraava\tCtrl+F6", ID_WINDOW_NEXT
    END

    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Tietoja...", ID_HELP_ABOUT
    END
END

STRINGTABLE
BEGIN
    IDS_OPENFILTER, "Kaikki tuetut muodot (*.bin,*.psf)|*.bin;*.psf|Binaarifonttitiedostot (*.bin)|*.bin|PC Screen Font -versio 1 (*.psf)|*.psf|"
    IDS_SAVEFILTER, "Binaarifonttitiedostot (*.bin)|*.bin|"
    IDS_OPENERROR, "Virhe avattaessa tiedostoa! (Virhenumero %1!u!)"
    IDS_READERROR, "Virhe luettaessa tiedostoa! (Virhenumero %1!u!)"
    IDS_WRITEERROR, "Virhe kirjoitettaessa tiedostoa! (Virhenumero %1!u!)"
    IDS_UNSUPPORTEDFORMAT, "Tiedostomuotoa ei tueta!"
    IDS_UNSUPPORTEDPSF, "PSF-fonttimuotoa ei tueta! Editori tukee vain 8x8-fontteja ilman erikoistiloja."
    IDS_DOCNAME, "Fontti %1!u!"
    IDS_SAVEPROMPT, "Tiedostoa ""%1"" on muutettu, mutta sitä ei ole tallennettu.\n\nHaluatko tallentaa sen?"
    IDS_APPTITLE, "ReactOS VGA -fonttieditori"
    IDS_CLOSEEDIT, "Sulje ensin kaikki avoimet muokkausikkunat!"

    IDS_TOOLTIP_NEW, "Uusi"
    IDS_TOOLTIP_OPEN, "Avaa"
    IDS_TOOLTIP_SAVE, "Tallenna"
    IDS_TOOLTIP_EDIT_GLYPH, "Muokkaa merkkiä"
    IDS_TOOLTIP_COPY, "Kopioi"
    IDS_TOOLTIP_PASTE, "Liitä"
END
