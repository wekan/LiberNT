LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDB_FONTSTOOLBAR BITMAP "img/fontstoolbar.bmp"

ID_MENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Uusi\tCtrl+N", IDM_FILENEW
        MENUITEM "&Avaa...\tCtrl+O", IDM_FILEOPEN
        MENUITEM "&Tallenna\tCtrl+S", IDM_FILESAVE
        MENUITEM "Tallenna &nimellä...", IDM_FILESAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Skannerista tai kamerasta...", IDM_FILEFROMSCANNERORCAMERA
        MENUITEM SEPARATOR
        MENUITEM "Sivun esikatselu", IDM_FILEPAGEVIEW
        MENUITEM "Sivun asetukset...", IDM_FILEPAGESETUP
        MENUITEM "T&ulosta...\tCtrl+P", IDM_FILEPRINT
        MENUITEM SEPARATOR
        MENUITEM "Lähetä...", IDM_FILESEND
        MENUITEM SEPARATOR
        MENUITEM "Aseta taustakuvaksi (vierekkäin)", IDM_FILEASWALLPAPERPLANE
        MENUITEM "Aseta taustakuvaksi (keskitetty)", IDM_FILEASWALLPAPERCENTERED
        MENUITEM "Aseta taustakuvaksi (venytetty)", IDM_FILEASWALLPAPERSTRETCHED
        MENUITEM SEPARATOR
        MENUITEM "Viimeksi käytetty tiedosto", IDM_FILEMOSTRECENTLYUSEDFILE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta\tAlt+F4", IDM_FILEEXIT
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Kumoa\tCtrl+Z", IDM_EDITUNDO
        MENUITEM "&Tee uudelleen\tCtrl+Y", IDM_EDITREDO
        MENUITEM SEPARATOR
        MENUITEM "&Leikkaa\tCtrl+X", IDM_EDITCUT
        MENUITEM "K&opioi\tCtrl+C", IDM_EDITCOPY
        MENUITEM "L&iitä\tCtrl+V", IDM_EDITPASTE
        MENUITEM SEPARATOR
        MENUITEM "&Rajaa valinta", IDM_CROPSELECTION
        MENUITEM "&Poista valinta\tDel", IDM_EDITDELETESELECTION
        MENUITEM "Kää&nteinen valinta", IDM_EDITINVERTSELECTION
        MENUITEM "&Valitse kaikki\tCtrl+A", IDM_EDITSELECTALL
        MENUITEM SEPARATOR
        MENUITEM "Kopioi kohtee&seen...", IDM_EDITCOPYTO
        MENUITEM "Liitä l&ähteestä...", IDM_EDITPASTEFROM
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Työkaluruutu\tCtrl+T", IDM_VIEWTOOLBOX, CHECKED
        MENUITEM "&Väripaletti\tCtrl+L", IDM_VIEWCOLORPALETTE, CHECKED
        MENUITEM "T&ilarivi", IDM_VIEWSTATUSBAR, CHECKED
        MENUITEM "Te&kstityökalurivi", IDM_FORMATICONBAR, CHECKED, GRAYED
        MENUITEM SEPARATOR
        POPUP "&Zoomaus"
        BEGIN
            POPUP "&Mukautettu"
            BEGIN
                MENUITEM "12.5%", IDM_VIEWZOOM125
                MENUITEM "25%", IDM_VIEWZOOM25
                MENUITEM "50%", IDM_VIEWZOOM50
                MENUITEM "100%", IDM_VIEWZOOM100
                MENUITEM "200%", IDM_VIEWZOOM200
                MENUITEM "400%", IDM_VIEWZOOM400
                MENUITEM "800%", IDM_VIEWZOOM800
            END
            MENUITEM SEPARATOR
            MENUITEM "Näytä &ruudukko\tCtrl+G", IDM_VIEWSHOWGRID
            MENUITEM "Näytä &pienoiskuva", IDM_VIEWSHOWMINIATURE
        END
        MENUITEM "&Koko näyttö\tCtrl+F", IDM_VIEWFULLSCREEN
    END
    POPUP "&Kuva"
    BEGIN
        MENUITEM "Kierrä/&peilaa...\tCtrl+R", IDM_IMAGEROTATEMIRROR
        MENUITEM "&Venytä/vinouta...\tCtrl+W", IDM_IMAGESTRETCHSKEW
        MENUITEM "&Rajaa", IDM_IMAGECROP
        MENUITEM "Kää&nnä värit\tCtrl+I", IDM_IMAGEINVERTCOLORS
        MENUITEM "&Määritteet...\tCtrl+E", IDM_IMAGEATTRIBUTES
        MENUITEM "&Tyhjennä kuva\tCtrl+Shft+N", IDM_IMAGEDELETEIMAGE
        MENUITEM "Piirrä p&eittävänä", IDM_IMAGEDRAWOPAQUE
    END
    POPUP "&Värit"
    BEGIN
        MENUITEM "&Muokkaa palettia...", IDM_COLORSEDITPALETTE
        MENUITEM SEPARATOR
        MENUITEM "Moderni paletti", IDM_COLORSMODERNPALETTE
        MENUITEM "Vanha paletti", IDM_COLORSOLDPALETTE
        MENUITEM "Harmaasävypaletti", IDM_COLORSGRAYSCALE
        MENUITEM "Mustavalkoinen paletti", IDM_COLORSMONOCHROME
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Ohjeen aiheet", IDM_HELPHELPTOPICS
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja", IDM_HELPINFO
    END
END

ID_POPUPMENU MENU
BEGIN
    POPUP "Popup #0"
    BEGIN
        MENUITEM "&Leikkaa\tCtrl+X", IDM_EDITCUT
        MENUITEM "K&opioi\tCtrl+C", IDM_EDITCOPY
        MENUITEM "L&iitä\tCtrl+V", IDM_EDITPASTE
        MENUITEM SEPARATOR
        MENUITEM "&Rajaa valinta", IDM_CROPSELECTION
        MENUITEM "&Poista valinta\tDel", IDM_EDITDELETESELECTION
        MENUITEM "&Valitse kaikki\tCtrl+A", IDM_EDITSELECTALL
        MENUITEM SEPARATOR
        MENUITEM "Kopioi kohtee&seen...", IDM_EDITCOPYTO
        MENUITEM "Liitä l&ähteestä...", IDM_EDITPASTEFROM
        MENUITEM SEPARATOR
        MENUITEM "Kierrä/&peilaa...\tCtrl+R", IDM_IMAGEROTATEMIRROR
        MENUITEM "&Venytä/vinouta...\tCtrl+W", IDM_IMAGESTRETCHSKEW
        MENUITEM "Kää&nnä värit\tCtrl+I", IDM_IMAGEINVERTCOLORS
    END
END

ID_ACCELERATORS ACCELERATORS
BEGIN
    "^N", IDM_FILENEW
    "^O", IDM_FILEOPEN
    "^S", IDM_FILESAVE
    "^Z", IDM_EDITUNDO
    "^Y", IDM_EDITREDO
    "^X", IDM_EDITCUT
    "^C", IDM_EDITCOPY
    "^V", IDM_EDITPASTE
    VK_DELETE, IDM_EDITDELETESELECTION, VIRTKEY
    "^A", IDM_EDITSELECTALL
    "^T", IDM_VIEWTOOLBOX
    "^L", IDM_VIEWCOLORPALETTE
    "^G", IDM_VIEWSHOWGRID
    "^F", IDM_VIEWFULLSCREEN
    "^R", IDM_IMAGEROTATEMIRROR
    "^W", IDM_IMAGESTRETCHSKEW
    "^I", IDM_IMAGEINVERTCOLORS
    "^E", IDM_IMAGEATTRIBUTES
    "N", IDM_IMAGEDELETEIMAGE, CONTROL, SHIFT, VIRTKEY
    VK_ADD, IDM_CTRL_PLUS, CONTROL, VIRTKEY
    VK_SUBTRACT, IDM_CTRL_MINUS, CONTROL, VIRTKEY
    VK_OEM_PLUS, IDM_CTRL_PLUS, CONTROL, VIRTKEY
    VK_OEM_MINUS, IDM_CTRL_MINUS, CONTROL, VIRTKEY
END

IDD_MIRRORROTATE DIALOGEX 100, 100, 180, 100
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Kierrä ja peilaa kuvaa"
BEGIN
    GROUPBOX "Kierrä tai peilaa", IDD_MIRRORROTATEGROUP, 6, 6, 112, 86
    AUTORADIOBUTTON "Peilaa &vaakasuunnassa", IDD_MIRRORROTATERB1, 12, 18, 100, 10, WS_GROUP
    AUTORADIOBUTTON "Peilaa &pystysuunnassa", IDD_MIRRORROTATERB2, 12, 30, 100, 10
    AUTORADIOBUTTON "&Kierrä kulman verran", IDD_MIRRORROTATERB3, 12, 42, 100, 10
    AUTORADIOBUTTON "&90°", IDD_MIRRORROTATERB4, 42, 54, 50, 10, WS_GROUP | WS_DISABLED
    AUTORADIOBUTTON "&180°", IDD_MIRRORROTATERB5, 42, 66, 50, 10, WS_DISABLED
    AUTORADIOBUTTON "&270°", IDD_MIRRORROTATERB6, 42, 78, 50, 10, WS_DISABLED
    DEFPUSHBUTTON "OK", IDOK, 125, 8, 48, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 125, 24, 48, 14
END

IDD_ATTRIBUTES DIALOGEX 100, 100, 225, 120
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Määritteet"
BEGIN
    LTEXT "&Leveys:", IDD_ATTRIBUTESTEXT1, 10, 42, 35, 10
    EDITTEXT IDD_ATTRIBUTESEDIT1, 48, 40, 35, 12
    LTEXT "&Korkeus:", IDD_ATTRIBUTESTEXT2, 90, 42, 35, 10
    EDITTEXT IDD_ATTRIBUTESEDIT2, 128, 40, 35, 12
    LTEXT "Tiedoston pvm:", IDD_ATTRIBUTESTEXT3, 10, 5, 60, 10
    LTEXT "Tiedoston koko:", IDD_ATTRIBUTESTEXT4, 10, 15, 60, 10
    LTEXT "Tarkkuus:", IDD_ATTRIBUTESTEXT5, 10, 25, 60, 10
    LTEXT "Ei käytettävissä", IDD_ATTRIBUTESTEXT6, 60, 5, 90, 10
    LTEXT "Ei käytettävissä", IDD_ATTRIBUTESTEXT7, 60, 15, 90, 10
    LTEXT "dpi", IDD_ATTRIBUTESTEXT8, 60, 25, 90, 10 /* This unit must match IDS_PRINTRES */
    GROUPBOX "Yksiköt", IDD_ATTRIBUTESGROUP1, 6, 57, 158, 27
    AUTORADIOBUTTON "&Tuumat", IDD_ATTRIBUTESRB1, 12, 69, 45, 10, WS_GROUP
    AUTORADIOBUTTON "c&m", IDD_ATTRIBUTESRB2, 62, 69, 45, 10
    AUTORADIOBUTTON "&Pikselit", IDD_ATTRIBUTESRB3, 112, 69, 45, 10
    GROUPBOX "Värit", IDD_ATTRIBUTESGROUP2, 6, 88, 158, 27
    AUTORADIOBUTTON "&Mustavalko", IDD_ATTRIBUTESRB4, 12, 100, 70, 10, WS_GROUP
    AUTORADIOBUTTON "&Värit", IDD_ATTRIBUTESRB5, 92, 100, 42, 10
    DEFPUSHBUTTON "OK", IDOK, 170, 8, 48, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 170, 24, 48, 14
    PUSHBUTTON "&Oletus", IDD_ATTRIBUTESSTANDARD, 170, 40, 48, 14
END

IDD_STRETCHSKEW DIALOGEX 100, 100, 225, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
FONT 8, "MS Shell Dlg"
CAPTION "Venytä ja vinouta kuvaa"
BEGIN
    GROUPBOX "Venytä", IDD_STRETCHSKEWGROUPSTRETCH, 6, 6, 158, 66
    ICON IDI_HORZSTRETCH, IDD_STRETCHSKEWICONHSTRETCH, 12, 18, 32, 32
    LTEXT "Vaakasuunta:", IDD_STRETCHSKEWTEXTHSTRETCH, 45, 24, 40, 10
    EDITTEXT IDD_STRETCHSKEWEDITHSTRETCH, 90, 23, 32, 12
    LTEXT "%", IDD_STRETCHSKEWTEXTHPERCENT, 125, 24, 15, 10
    ICON IDI_VERTSTRETCH, IDD_STRETCHSKEWICONVSTRETCH, 12, 43, 32, 32
    LTEXT "Pystysuunta:", IDD_STRETCHSKEWTEXTVSTRETCH, 45, 49, 40, 10
    EDITTEXT IDD_STRETCHSKEWEDITVSTRETCH, 90, 48, 32, 12
    LTEXT "%", IDD_STRETCHSKEWTEXTVPERCENT, 125, 49, 15, 10
    GROUPBOX "Vinouta", IDD_STRETCHSKEWGROUPSKEW, 6, 76, 158, 66
    ICON IDI_HORZSKEW, IDD_STRETCHSKEWICONHSKEW, 12, 88, 32, 32
    LTEXT "Vaakasuunta:", IDD_STRETCHSKEWTEXTHSKEW, 45, 94, 40, 10
    EDITTEXT IDD_STRETCHSKEWEDITHSKEW, 90, 93, 32, 12
    LTEXT "astetta", IDD_STRETCHSKEWTEXTHDEG, 125, 94, 30, 10
    ICON IDI_VERTSKEW, IDD_STRETCHSKEWICONVSKEW, 12, 113, 32, 32
    LTEXT "Pystysuunta:", IDD_STRETCHSKEWTEXTVSKEW, 45, 119, 40, 10
    EDITTEXT IDD_STRETCHSKEWEDITVSKEW, 90, 118, 32, 12
    LTEXT "astetta", IDD_STRETCHSKEWTEXTVDEG, 125, 119, 30, 10
    DEFPUSHBUTTON "OK", IDOK, 170, 8, 48, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 170, 24, 48, 14
END

IDD_FONTS DIALOG 0, 0, 225, 25
CAPTION "Fontit"
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
EXSTYLE WS_EX_TOOLWINDOW
FONT 8, "MS Shell Dlg"
BEGIN
    COMBOBOX IDD_FONTSNAMES, 5, 5, 110, 200, CBS_HASSTRINGS | CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | CBS_OWNERDRAWFIXED | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDD_FONTSSIZES, 120, 5, 35, 250, CBS_HASSTRINGS | CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDD_FONTSTOOLBAR, "ToolbarWindow32", TBSTYLE_TOOLTIPS | CCS_NODIVIDER | CCS_NOPARENTALIGN | CCS_NOMOVEY, 160, 5, 60, 20
END

STRINGTABLE
BEGIN
    IDS_PROGRAMNAME "Paint"
    IDS_WINDOWTITLE "%s - Paint"
    IDS_INFOTITLE "Paint LiberNT:lle"
    IDS_INFOTEXT "Saatavilla GNU Lesser General Public License -lisenssillä (LGPL, katso www.gnu.org)"
    IDS_SAVEPROMPTTEXT "Haluatko tallentaa tiedostoon %s tehdyt muutokset?"
    IDS_DEFAULTFILENAME "Nimetön"
    IDS_MINIATURETITLE "Pienoiskuva"
    IDS_TOOLTIP1 "Vapaa valinta"
    IDS_TOOLTIP2 "Valinta"
    IDS_TOOLTIP3 "Pyyhekumi"
    IDS_TOOLTIP4 "Täytä värillä"
    IDS_TOOLTIP5 "Valitse väri"
    IDS_TOOLTIP6 "Zoomaus"
    IDS_TOOLTIP7 "Kynä"
    IDS_TOOLTIP8 "Sivellin"
    IDS_TOOLTIP9 "Ruiskupullo"
    IDS_TOOLTIP10 "Teksti"
    IDS_TOOLTIP11 "Viiva"
    IDS_TOOLTIP12 "Bézier-käyrä"
    IDS_TOOLTIP13 "Suorakulmio"
    IDS_TOOLTIP14 "Monikulmio"
    IDS_TOOLTIP15 "Ellipsi"
    IDS_TOOLTIP16 "Pyöristetty suorakulmio"
    IDS_ALLFILES "Kaikki tiedostot"
    IDS_ALLPICTUREFILES "Kaikki kuvatiedostot"
    IDS_FILESIZE "%d tavua"
    IDS_INTNUMBERS "Anna vain kokonaislukuja!"
    IDS_PERCENTAGE "Prosenttiluvun on oltava välillä 1–500."
    IDS_ANGLE "Kulman on oltava välillä -89–89."
    IDS_LOADERRORTEXT "Tiedostoa %s ei voitu ladata."
    IDS_ENLARGEPROMPTTEXT "Leikepöydällä oleva kuva on suurempi kuin bittikartta.\nHaluatko suurentaa bittikarttaa?"
    IDS_BOLD "Lihavointi"
    IDS_ITALIC "Kursivointi"
    IDS_UNDERLINE "Alleviivaus"
    IDS_VERTICAL "Pystysuora"
    IDS_PRINTRES "%d x %d pistettä tuumalla"
    IDS_CANTPASTE "Liittäminen leikepöydältä epäonnistui. Tietomuoto on virheellinen tai sitä ei tueta."
    IDS_SAVEERROR "Bittikartan tallentaminen tiedostoon epäonnistui:\n\n%s"
    IDS_CANTSENDMAIL "Sähköpostin lähettäminen epäonnistui."
    IDS_LOSECOLOR "Väritiedot menetetään tässä toiminnossa. Haluatko varmasti jatkaa?"
END
