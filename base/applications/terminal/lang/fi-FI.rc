IDD_ABOUT DIALOGEX 0, 0, 250, 104
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tietoja Päätteestä"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_ABOUT_ICON, 12, 12, 32, 32
    LTEXT           "", IDC_ABOUT_NAME, 54, 12, 186, 10
    LTEXT           "", IDC_ABOUT_VERSION, 54, 25, 186, 10
    LTEXT           "", IDC_ABOUT_COPYRIGHT, 54, 38, 186, 10
    LTEXT           "", IDC_ABOUT_DESCRIPTION, 54, 54, 186, 22
    DEFPUSHBUTTON   "OK", IDOK, 190, 82, 50, 14
END

IDD_RENAME DIALOGEX 0, 0, 220, 58
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Nimeä välilehti uudelleen"
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT        IDC_RENAME_EDIT, 7, 9, 206, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 108, 36, 50, 14
    PUSHBUTTON      "Peruuta", IDCANCEL, 163, 36, 50, 14
END

