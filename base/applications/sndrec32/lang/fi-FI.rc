LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDC_REACTOS_SNDREC32 ACCELERATORS
BEGIN
    "?", IDM_ABOUT, ASCII, ALT
    "/", IDM_ABOUT, ASCII, ALT
END

IDR_MENU1 MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Uusi", ID_FILE_NEW
        MENUITEM "&Avaa...", ID_FILE_OPEN
        MENUITEM "&Tallenna", ID_FILE_SAVE, GRAYED
        MENUITEM "Tallenna &nimellä...", ID_FILE_SAVEAS, GRAYED
        MENUITEM "&Palauta...", ID_FILE_RESTORE, GRAYED
        MENUITEM "&Ominaisuudet", ID_FILE_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", ID_FILE_EXIT
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Kopioi", ID_EDIT_COPY
        MENUITEM "&Liitä lisäten", ID_EDIT_PASTE, GRAYED
        MENUITEM "Liitä &sekoittaen", ID_EDIT_PASTEMIX, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Lisää &tiedosto...", ID_EDIT_INSERTFILE
        MENUITEM "Sek&oita tiedostoon...", ID_EDIT_MIXFILE
        MENUITEM SEPARATOR
        MENUITEM "Poista &ennen nykyistä kohtaa", ID_EDIT_DELETEBEFORE, GRAYED
        MENUITEM "Poista nykyisen kohdan &jälkeen", ID_EDIT_DELETEAFTER, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Ä&äniominaisuudet", ID_EDIT_AUDIOPROPS
    END
    POPUP "T&ehosteet"
    BEGIN
        MENUITEM "&Lisää äänenvoimakkuutta (25%)", ID_EFFECTS_INCVOL
        MENUITEM "&Vähennä äänenvoimakkuutta", ID_EFFECTS_DECVOL
        MENUITEM SEPARATOR
        MENUITEM "L&isää nopeutta (100%)", ID_EFFECTS_INCSPD
        MENUITEM "V&ähennä nopeutta", ID_EFFECTS_DECSPD
        MENUITEM SEPARATOR
        MENUITEM "Lisää &kaiku", ID_EFFECTS_ECHO
        MENUITEM "&Takaperin", ID_EFFECTS_REVERSE
    END
    POPUP "&?"
    BEGIN
        MENUITEM "&Tietoja", ID_ABOUT
    END
END

STRINGTABLE
BEGIN
    IDS_APP_TITLE "Ääninauhuri"
    IDC_REACTOS_SNDREC32 "REACTOS_SNDREC32"
END

STRINGTABLE
BEGIN
    IDS_STRPOS "Sijainti: %.2f s"
    IDS_STRDUR "Pituus: %.2f s"
    IDS_STRBUF "Puskuri: %.2f kt"
    IDS_STRFMT "%.1f kHz %u bittiä"
    IDS_STRMONO "mono"
    IDS_STRSTEREO "stereo"
    IDS_STRCHAN "%s"
END
