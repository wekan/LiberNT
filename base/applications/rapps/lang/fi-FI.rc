LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDR_MAINMENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Asetukset", ID_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", ID_EXIT
    END
    POPUP "&Ohjelmat"
    BEGIN
        MENUITEM "&Asenna\tCtrl+Enter", ID_INSTALL
        MENUITEM "&Poista asennus\tCtrl+Del", ID_UNINSTALL
        MENUITEM "&Muuta", ID_MODIFY
        MENUITEM SEPARATOR
        MENUITEM "Poista &rekisteristä", ID_REGREMOVE
        MENUITEM SEPARATOR
        MENUITEM "P&äivitä\tF5", ID_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "Päivitä &tietokanta\tCtrl+F5", ID_RESETDB
    END
    POPUP "Ohje"
    BEGIN
        MENUITEM "Ohje\tF1", ID_HELP, GRAYED
        MENUITEM "&Tietoja", ID_ABOUT
    END
END

IDR_LINKMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Avaa linkki selaimessa", ID_OPEN_LINK
        MENUITEM "&Kopioi linkki leikepöydälle", ID_COPY_LINK
    END
END

IDD_SETTINGS_DIALOG DIALOGEX 0, 0, 250, 265
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Asetukset"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Yleiset", -1, 4, 2, 240, 61
    CONTROL "", IDC_GENERALLIST, "SysListView32", WS_TABSTOP | LVCHECKSTYLES, 15, 12, 219, 46, WS_EX_STATICEDGE
    GROUPBOX "Lataaminen", -1, 4, 65, 240, 51
    LTEXT "Latauskansio:", -1, 16, 75, 100, 9
    EDITTEXT IDC_DOWNLOAD_DIR_EDIT, 15, 86, 166, 12, WS_CHILD | WS_VISIBLE | WS_GROUP | ES_AUTOHSCROLL
    PUSHBUTTON "&Valitse", IDC_CHOOSE, 187, 85, 50, 14
    AUTOCHECKBOX "&Poista asennusohjelma asennuksen jälkeen", IDC_DEL_AFTER_INSTALL, 16, 100, 218, 12
    GROUPBOX "Ohjelmistolähde", -1, 4, 118, 240, 46
    AUTORADIOBUTTON "Oletus", IDC_SOURCE_DEFAULT, 15, 132, 74, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Määritetty lähde", IDC_USE_SOURCE, 15, 147, 74, 10
    EDITTEXT IDC_SOURCE_URL, 97, 147, 140, 12, ES_AUTOHSCROLL | WS_DISABLED
    GROUPBOX "Välityspalvelin", -1, 4, 166, 240, 76
    AUTORADIOBUTTON "Järjestelmän välityspalvelinasetukset", IDC_PROXY_DEFAULT, 15, 180, 210, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Suora (ei välityspalvelinta)", IDC_NO_PROXY, 15, 195, 210, 10
    AUTORADIOBUTTON "Välityspalvelin", IDC_USE_PROXY, 15, 210, 74, 10
    EDITTEXT IDC_PROXY_SERVER, 90, 210, 147, 12, ES_AUTOHSCROLL | WS_DISABLED
    LTEXT "Ohita välityspalvelin", -1, 26, 226, 64, 10
    EDITTEXT IDC_NO_PROXY_FOR, 90, 225, 147, 12, ES_AUTOHSCROLL | WS_DISABLED
    PUSHBUTTON "Oletukset", IDC_DEFAULT_SETTINGS, 8, 245, 60, 14, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 116, 245, 60, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 181, 245, 60, 14
END

IDD_INSTALL_DIALOG DIALOGEX 0, 0, 216, 97
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Ohjelman asennus"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "…", IDC_INSTALL_TEXT, 4, 5, 209, 35
    AUTORADIOBUTTON "&Asenna levyltä (CD tai DVD)", IDC_CD_INSTALL, 10, 46, 197, 11, WS_GROUP
    AUTORADIOBUTTON "&Lataa ja asenna", IDC_DOWNLOAD_INSTALL, 10, 59, 197, 11, NOT WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 86, 78, 60, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 150, 78, 60, 14
END

IDD_DOWNLOAD_DIALOG DIALOGEX 0, 0, 220, 220
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUPWINDOW | WS_CAPTION
CAPTION "Ladataan %ls…"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_DOWNLOAD_PROGRESS, "msctls_progress32", WS_BORDER | PBS_SMOOTH, 10, 10, 200, 12
    EDITTEXT IDC_DOWNLOAD_STATUS, 10, 28, 200, 22, ES_CENTER | ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_DISABLED | NOT WS_BORDER
    PUSHBUTTON "Peruuta", IDCANCEL, 85, 53, 50, 15, WS_GROUP | WS_TABSTOP
END

