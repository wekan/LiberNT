LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

/* Dialog */
IDD_GUI DIALOGEX 0, 0, 240, 255
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Etäsammutus"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "&OK", IDC_OK, 125, 232, 50, 14
    PUSHBUTTON "&Peruuta", IDC_CANCEL, 178, 232, 50, 14
    LTEXT "&Tietokoneet:", IDC_STATIC, 9, 9, 35, 36
    LISTBOX IDC_COMPUTER_LIST, 8, 19, 162, 55
    PUSHBUTTON "&Lisää...", IDC_ADD_SYSTEM, 179, 19, 50, 14
    PUSHBUTTON "P&oista", IDC_REMOVE_SYSTEM, 179, 36, 50, 14, WS_DISABLED
    PUSHBUTTON "&Selaa...", IDC_BROWSE_SYSTEM, 179, 53, 50, 14
    LTEXT "Toiminto", IDC_ACTION, 11, 81, 20, 14
    COMBOBOX IDC_ACTION_TYPE, 37, 79, 129, 14, WS_TABSTOP | CBS_DROPDOWN
    CHECKBOX "Varoita", IDC_WARN_USERS, 175, 79, 55, 14, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT "Näytä varoitus", IDC_SHOW_WARN_ONE, 11, 99, 65, 14
    EDITTEXT IDC_SHOW_WARN, 78, 97, 41, 14
    LTEXT "sekuntia", IDC_SHOW_WARN_TWO, 124, 99, 32, 10
    GROUPBOX "Sammutustapahtumien seuranta", IDC_STATIC, 5, 114, 224, 114
    LTEXT "Syy:", IDC_STATIC, 16, 130, 27, 8
    CHECKBOX "Suunniteltu", IDC_PLANNED, 175, 130, 40, 12, BS_AUTOCHECKBOX | WS_TABSTOP
    COMBOBOX IDC_REASON_CODE, 17, 142, 198, 13, WS_TABSTOP | CBS_DROPDOWN
    LTEXT "&Kommentti:", IDC_COMMENT_CAPTION, 16, 159, 38, 8
    EDITTEXT IDC_COMMENT_TEXT, 17, 171, 198, 50, WS_VSCROLL
END

/* Information and error messages */
STRINGTABLE
BEGIN
    IDS_USAGE "LiberNT:n sammutusapuohjelma\n\
\n\
Käyttö: shutdown [/?] [/i | /l | /s | /r | /g | /a | /p | /h | /e] [/f]\n\
       [/m \\\\tietokone][/t xxx][/d [p|u:]xx:yy [/c ""kommentti""]]\n\
\n\
    Ei argumentteja tai /?  Näyttää tämän ohjeen.\n\
    /i      Näyttää graafisen käyttöliittymän. Tämän valitsimen on oltava\n\
            ensimmäinen.\n\
    /l      Kirjautuu ulos paikallisesta järjestelmästä. Ei /m:n tai /d:n kanssa.\n\
    /s      Sammuttaa tietokoneen.\n\
    /r      Käynnistää tietokoneen uudelleen.\n\
    /g      Käynnistää tietokoneen ja rekisteröidyt sovellukset uudelleen.\n\
    /a      Peruuttaa viivästetyn sammutuksen. Käytettävissä vain viiveen\n\
            aikana.\n\
    /p      Sammuttaa paikallisen tietokoneen ilman viivettä tai varoitusta.\n\
            Voidaan käyttää /d- tai /f-valitsimen kanssa.\n\
    /h      Siirtää paikallisen tietokoneen horrostilaan. Myös /f:n kanssa.\n\
    /e      Kirjaa odottamattoman sammutuksen syyn.\n\
    /m \\\\tietokone  Määrittää kohdetietokoneen (UNC/IP-osoite).\n\
    /t xxx  Asettaa sammutusta edeltäväksi aikakatkaisuksi xxx sekuntia.\n\
            Kelvollinen alue on 0 - 315360000 (10 vuotta),\n\
            oletusarvo on 30.\n\
    /c ""kommentti""  Kommentti sammutuksen tai uudelleenkäynnistyksen syystä.\n\
            Enintään 512 merkkiä.\n\
    /f      Sulkee käynnissä olevat sovellukset väkisin varoittamatta käyttäjiä.\n\
            Jos muita parametreja ei anneta, tämä valitsin myös kirjaa ulos.\n\
    /d [p|u:]xx:yy  Antaa sammutuksen tai uudelleenkäynnistyksen syykoodin.\n\
            p tarkoittaa, että sammutus tai uudelleenkäynnistys on suunniteltu.\n\
            u tarkoittaa, että syy on käyttäjän määrittämä.\n\
            Jos p:tä tai u:ta ei määritetä, sammutus tai uudelleenkäynnistys\n\
            ei ole suunniteltu.\n\
            xx on pääsyykoodi (positiivinen kokonaisluku, alle 256).\n\
            yy on alisyykoodi (positiivinen kokonaisluku, alle 65536).\n"

    IDS_ERROR_SHUTDOWN_REBOOT "VIRHE: Sammutus ja uudelleenkäynnistys eivät ole mahdollisia samanaikaisesti.\n"
    IDS_ERROR_TIMEOUT "VIRHE: Aikakatkaisun arvo %u on sallitun alueen ulkopuolella (0-315360000).\n"
    IDS_ERROR_ABORT "VIRHE: Järjestelmän sammutusta ei voi keskeyttää.\n"
    IDS_ERROR_LOGOFF "VIRHE: Järjestelmästä ei voi kirjautua ulos.\n"
    IDS_ERROR_SHUTDOWN "VIRHE: Järjestelmää ei voi sammuttaa.\n"
    IDS_ERROR_RESTART "VIRHE: Järjestelmää ei voi käynnistää uudelleen.\n"
    IDS_ERROR_MAX_COMMENT_LENGTH "VIRHE: Kommentin pituus ylittää järjestelmän asettaman merkkirajan.\n"
    IDS_ERROR_HIBERNATE "VIRHE: Järjestelmää ei voi siirtää horrostilaan.\n"
    IDS_ERROR_HIBERNATE_LOCAL "VIRHE: Horrostilaa ei voi käynnistää etäyhteydellä.\n"
    IDS_ERROR_HIBERNATE_ENABLED "VIRHE: Horrostila ei ole käytössä.\n"
    IDS_ERROR_DIALOG_CAPTION "Etäsammutus"
    IDS_ERROR_DIALOG_INIT "Graafista käyttöliittymää ei voi näyttää."
END

/* Remote shutdown action strings */
STRINGTABLE
BEGIN
    IDS_ACTION_SHUTDOWN "Sammuta järjestelmä"
    IDS_ACTION_RESTART "Käynnistä järjestelmä uudelleen"
    IDS_ACTION_UNEXPECTED_SHUTDOWN "Kirjaa odottamaton sammutus"
END

/* Remote shutdown reason strings */
STRINGTABLE
BEGIN
    IDS_REASON_OTHER "Muu"
    IDS_REASON_HARDWARE_MAINTENANCE "Laitteisto: Huolto"
    IDS_REASON_HARDWARE_INSTALL "Laitteisto: Asennus"
    IDS_REASON_OS_RECOVER "Käyttöjärjestelmä: Palautus"
    IDS_REASON_OS_RECONFIGURE "Käyttöjärjestelmä: Uudelleenmääritys"
    IDS_REASON_APP_MAINTENANCE "Sovellus: Huolto"
    IDS_REASON_APP_INSTALL "Sovellus: Asennus"
    IDS_REASON_APP_UNRESPONSIVE "Sovellus: Ei vastaa"
    IDS_REASON_APP_UNSTABLE "Sovellus: Epävakaa"
    IDS_REASON_SECURITY "Tietoturvaongelma"
    IDS_REASON_NETWORK "Verkkoyhteys katkesi"
END
