BEGIN
    STRING_CLIPBOARD "Leikepöydän katseluohjelma"
    STRING_CLIPFILE  "Leikepöydän elementti"
    STRING_DELETE_MSG "Tyhjennetäänkö leikepöydän sisältö?"
