LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

ID_ACCEL ACCELERATORS
BEGIN
    VK_DELETE, CMD_DELETE, VIRTKEY
END

MAIN_MENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Avaa...", CMD_OPEN
        MENUITEM "Tallenna &nimellä...", CMD_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", CMD_EXIT
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Poista\tDel", CMD_DELETE
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Automaattinen", CMD_AUTOMATIC
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Ohjeen aiheet", CMD_HELP
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja", CMD_ABOUT
    END
END

