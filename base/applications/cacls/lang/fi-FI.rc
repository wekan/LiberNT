LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_HELP "Näyttää tai muokkaa tiedostojen käyttöoikeusluetteloita (ACL)\n\n\
CACLS tiedostonimi [/T] [/E] [/C] [/G käyttäjä:oikeus [...]] [/R käyttäjä [...]]\n\
               [/P käyttäjä:oikeus [...]] [/D käyttäjä [...]]\n\
   tiedostonimi  Näyttää käyttöoikeusluettelot.\n\
   /T            Muuttaa määritettyjen tiedostojen käyttöoikeusluetteloita\n\
                 nykyisessä kansiossa ja kaikissa alikansioissa.\n\
   /E            Muokkaa käyttöoikeusluetteloa korvaamisen sijaan.\n\
   /C            Jatka, vaikka käyttö estettäisiin.\n\
   /G käyttäjä:oikeus  Myönnä määritetylle käyttäjälle käyttöoikeudet.\n\
                 Oikeus voi olla: R  Luku\n\
                              W  Kirjoitus\n\
                              C  Muutos (kirjoitus)\n\
                              F  Täydet oikeudet\n\
   /R käyttäjä   Peruuta määritetyn käyttäjän käyttöoikeudet (vain /E:n kanssa).\n\
   /P käyttäjä:oikeus  Korvaa määritetyn käyttäjän käyttöoikeudet.\n\
                 Oikeus voi olla: N  Ei mitään\n\
                              R  Luku\n\
                              W  Kirjoitus\n\
                              C  Muutos (kirjoitus)\n\
                              F  Täydet oikeudet\n\
   /D käyttäjä   Estä määritetyn käyttäjän käyttö.\n\
Yleismerkeillä voi määrittää komennossa useamman kuin yhden tiedoston.\n\
Komennossa voi määrittää useamman kuin yhden käyttäjän.\n\n\
Lyhenteet:\n\
   CI - Säilön periytyminen.\n\
        Kansiot perivät ACE-merkinnän.\n\
   OI - Objektin periytyminen.\n\
        Tiedostot perivät ACE-merkinnän.\n\
   IO - Vain periytyminen.\n\
        ACE-merkintä ei koske nykyistä tiedostoa tai kansiota.\n"
    IDS_ABBR_CI "(CI)"
    IDS_ABBR_OI "(OI)"
    IDS_ABBR_IO "(IO)"
    IDS_ABBR_FULL "F"
    IDS_ABBR_READ "R"
    IDS_ABBR_WRITE "W"
    IDS_ABBR_CHANGE "C"
    IDS_ABBR_NONE "N"
    IDS_ALLOW ""
    IDS_DENY "(ESTÄ)"
    IDS_SPECIAL_ACCESS "(erikoisoikeudet:)"
    IDS_GENERIC_READ "GENERIC_READ"
    IDS_GENERIC_WRITE "GENERIC_WRITE"
    IDS_GENERIC_EXECUTE "GENERIC_EXECUTE"
    IDS_GENERIC_ALL "GENERIC_ALL"
    IDS_FILE_GENERIC_EXECUTE "FILE_GENERIC_EXECUTE"
    IDS_FILE_GENERIC_READ "FILE_GENERIC_READ"
    IDS_FILE_GENERIC_WRITE "FILE_GENERIC_WRITE"
    IDS_FILE_READ_DATA "FILE_READ_DATA"
    IDS_FILE_WRITE_DATA "FILE_WRITE_DATA"
    IDS_FILE_APPEND_DATA "FILE_APPEND_DATA"
    IDS_FILE_READ_EA "FILE_READ_EA"
    IDS_FILE_WRITE_EA "FILE_WRITE_EA"
    IDS_FILE_EXECUTE "FILE_EXECUTE"
    IDS_FILE_DELETE_CHILD "FILE_DELETE_CHILD"
    IDS_FILE_READ_ATTRIBUTES "FILE_READ_ATTRIBUTES"
    IDS_FILE_WRITE_ATTRIBUTES "FILE_WRITE_ATTRIBUTES"
    IDS_MAXIMUM_ALLOWED "MAXIMUM_ALLOWED"
    IDS_ACCESS_SYSTEM_SECURITY "ACCESS_SYSTEM_SECURITY"
    IDS_SPECIFIC_RIGHTS_ALL "SPECIFIC_RIGHTS_ALL"
    IDS_STANDARD_RIGHTS_REQUIRED "STANDARD_RIGHTS_REQUIRED"
    IDS_SYNCHRONIZE "SYNCHRONIZE"
    IDS_WRITE_OWNER "WRITE_OWNER"
    IDS_WRITE_DAC "WRITE_DAC"
    IDS_READ_CONTROL "READ_CONTROL"
    IDS_DELETE "DELETE"
    IDS_STANDARD_RIGHTS_ALL "STANDARD_RIGHTS_ALL"
END
