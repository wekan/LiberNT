    PUSHBUTTON "Kyllä", IDOK, 26, 129, 54, 13
    DEFPUSHBUTTON "Ei", IDCANCEL, 102, 129, 54, 13
END

IDD_DLG_DEPEND_STOP DIALOGEX 6, 6, 240, 148
CAPTION "Pysäytä muut palvelut"
FONT 8, "MS Shell Dlg", 0, 0
