LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDR_MAINMENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Vie...", ID_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", ID_EXIT
    END
    POPUP "T&oiminto"
    BEGIN
        MENUITEM "&Yhdistä...", ID_CONNECT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Käynnistä", ID_START, GRAYED
        MENUITEM "&Pysäytä", ID_STOP, GRAYED
        MENUITEM "Ke&skeytä", ID_PAUSE, GRAYED
        MENUITEM "&Jatka", ID_RESUME, GRAYED
        MENUITEM "Käynnistä &uudelleen", ID_RESTART, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Päivi&tä\tF5", ID_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Muokkaa...", ID_EDIT, GRAYED
        MENUITEM "&Luo...", ID_CREATE, GRAYED
        MENUITEM "P&oista...", ID_DELETE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Omina&isuudet...", ID_PROP, GRAYED
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Suuret kuvakkeet", ID_VIEW_LARGE
        MENUITEM "&Pienet kuvakkeet", ID_VIEW_SMALL
        MENUITEM "&Luettelo", ID_VIEW_LIST
        MENUITEM "&Tiedot", ID_VIEW_DETAILS
        MENUITEM SEPARATOR
        MENUITEM "M&ukauta...", ID_VIEW_CUST, GRAYED
    END
    POPUP "O&hje"
    BEGIN
        MENUITEM "O&hje", ID_HELP
        MENUITEM "&Tietoja", ID_ABOUT
    END
END

IDR_POPUP MENU
BEGIN
    POPUP "popup"
    BEGIN
        MENUITEM "&Käynnistä", ID_START, GRAYED
        MENUITEM "&Pysäytä", ID_STOP, GRAYED
        MENUITEM "Ke&skeytä", ID_PAUSE, GRAYED
        MENUITEM "&Jatka", ID_RESUME, GRAYED
        MENUITEM "Käynnistä &uudelleen", ID_RESTART, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Päivi&tä", ID_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Muokkaa...", ID_EDIT, GRAYED
        MENUITEM "P&oista...", ID_DELETE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Omina&isuudet...", ID_PROP, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "Ohje...", ID_HELP
    END
END

IDA_SERVMAN ACCELERATORS
BEGIN
    VK_F5, ID_REFRESH, VIRTKEY
END

IDD_DLG_GENERAL DIALOGEX 6, 6, 253, 232
CAPTION "Yleiset"
FONT 8, "MS Shell Dlg", 0, 0
STYLE DS_SHELLFONT | WS_BORDER | WS_VISIBLE | WS_DLGFRAME | WS_SYSMENU | WS_GROUP | WS_TABSTOP
BEGIN
    LTEXT "", IDC_SERV_NAME, 70, 11, 176, 11, WS_CHILD | WS_VISIBLE
    EDITTEXT IDC_DISP_NAME, 70, 29, 176, 13, WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_READONLY
    EDITTEXT IDC_DESCRIPTION, 70, 46, 176, 24, WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP | ES_MULTILINE | ES_READONLY
    EDITTEXT IDC_EXEPATH, 6, 86, 239, 13, WS_CHILD | WS_VISIBLE | WS_TABSTOP | ES_READONLY
    COMBOBOX IDC_START_TYPE, 70, 107, 176, 40, WS_CHILD | WS_VISIBLE | WS_TABSTOP | CBS_DROPDOWNLIST
    PUSHBUTTON "&Käynnistä", IDC_START, 6, 155, 54, 15, WS_DISABLED
    PUSHBUTTON "&Pysäytä", IDC_STOP, 68, 155, 54, 15, WS_DISABLED
    PUSHBUTTON "Ke&skeytä", IDC_PAUSE, 130, 155, 54, 15, WS_DISABLED
    PUSHBUTTON "&Jatka", IDC_RESUME, 192, 155, 54, 15, WS_DISABLED
    LTEXT "Palvelun nimi:", IDC_STATIC, 7, 11, 53, 11
    LTEXT "Näyttönimi:", IDC_STATIC, 7, 29, 53, 11
    LTEXT "Kuvaus:", IDC_STATIC, 7, 51, 53, 11
    LTEXT "Suoritettavan tiedoston polku:", IDC_STATIC, 7, 73, 82, 9
    LTEXT "Käynnistystapa:", IDC_STATIC, 7, 108, 53, 11
    LTEXT "Palvelun tila:", IDC_STATIC, 7, 138, 53, 11
    LTEXT "", IDC_SERV_STATUS, 70, 138, 176, 11, WS_CHILD | WS_VISIBLE
    LTEXT "Voit määrittää käynnistysparametrit, joita käytetään, kun palvelu käynnistetään tästä.", IDC_STATIC, 7, 177, 240, 15
    LTEXT "Käynnistysparametrit:", IDC_STATIC, 7, 200, 58, 11
    EDITTEXT IDC_START_PARAM, 68, 199, 178, 13, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    PUSHBUTTON "Muokkaa", IDC_EDIT, 192, 215, 54, 15, WS_DISABLED
END

IDD_LOGON DIALOGEX 6, 6, 253, 232
CAPTION "Kirjautuminen"
FONT 8, "MS Shell Dlg", 0, 0
STYLE DS_SHELLFONT | WS_BORDER | WS_VISIBLE | WS_DLGFRAME | WS_SYSMENU | WS_GROUP | WS_TABSTOP
BEGIN
    LTEXT "Kirjautumistili:", IDC_STATIC, 7, 7, 238, 8
    AUTORADIOBUTTON "&Paikallinen järjestelmätili", IDC_LOGON_SYSTEMACCOUNT, 7, 22, 238, 10, BS_TOP | BS_MULTILINE | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Tämä tili:", IDC_LOGON_THISACCOUNT, 7, 52, 60, 10, BS_TOP | BS_MULTILINE | WS_CHILD | WS_VISIBLE
    AUTOCHECKBOX "Salli palvelun olla &vuorovaikutuksessa työpöydän kanssa", IDC_LOGON_INTERACTIVE, 18, 34, 227, 10, WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | BS_TOP | BS_MULTILINE
    EDITTEXT IDC_LOGON_ACCOUNTNAME, 72, 50, 103, 14, ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP
    PUSHBUTTON "&Selaa...", IDC_LOGON_SEARCH, 185, 50, 60, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    LTEXT "Sa&lasana:", IDC_LOGON_PW1TEXT, 18, 71, 33, 8, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_GROUP
    EDITTEXT IDC_LOGON_PASSWORD1, 72, 68, 104, 14, ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
    LTEXT "Va&hvista salasana:", IDC_LOGON_PW2TEXT, 18, 84, 47, 18, WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_GROUP
    EDITTEXT IDC_LOGON_PASSWORD2, 72, 86, 104, 14, ES_LEFT | ES_PASSWORD | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
    LTEXT "Voit ottaa palvelun käyttöön tai poistaa sen käytöstä alla luetelluissa laitteistoprofiileissa:", IDC_STATIC, 7, 114, 210, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
    CONTROL "", IDC_LOGON_HWPROFILE, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP | WS_TABSTOP, 7, 124, 238, 65
    PUSHBUTTON "&Ota käyttöön", IDC_LOGON_HWENABLE, 116, 197, 60, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "Poista &käytöstä", IDC_LOGON_HWDISABLE, 185, 197, 60, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_DISABLED
END

IDD_RECOVERY DIALOGEX 6, 6, 253, 232
CAPTION "Palautus"
FONT 8, "MS Shell Dlg", 0, 0
STYLE DS_SHELLFONT | WS_BORDER | WS_VISIBLE | WS_DLGFRAME | WS_SYSMENU | WS_GROUP | WS_TABSTOP
BEGIN
    LTEXT "Valitse tietokoneen toiminta, jos tämä palvelu epäonnistuu.", IDC_STATIC, 7, 7, 238, 8
    LTEXT "&Ensimmäinen virhe:", IDC_STATIC, 7, 24, 92, 8
    COMBOBOX IDC_FIRST_FAILURE, 104, 22, 141, 147, WS_CHILD | WS_VISIBLE | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "&Toinen virhe:", IDC_STATIC, 7, 41, 92, 8
    COMBOBOX IDC_SECOND_FAILURE, 104, 39, 141, 147, WS_CHILD | WS_VISIBLE | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "Seuraavat virheet:", IDC_STATIC, 7, 58, 92, 8
    COMBOBOX IDC_SUBSEQUENT_FAILURES, 104, 56, 141, 147, WS_CHILD | WS_VISIBLE | WS_TABSTOP | CBS_DROPDOWNLIST
    LTEXT "Nollaa &virhelaskuri:", IDC_STATIC, 7, 75, 72, 8
    EDITTEXT IDC_RESET_TIME, 104, 73, 40, 13, WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | ES_LEFT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "päivän kuluttua", IDC_STATIC, 150, 75, 95, 8
    LTEXT "Käynnistä palvelu &uudelleen:", IDC_RESTART_TEXT1, 7, 92, 92, 8
    EDITTEXT IDC_RESTART_TIME, 104, 90, 40, 13, WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP | ES_LEFT | ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "minuutin kuluttua", IDC_RESTART_TEXT2, 150, 92, 95, 8
    GROUPBOX "Suorita ohjelma", IDC_RUN_GROUPBOX, 7, 108, 238, 80
    LTEXT "&Ohjelma:", IDC_RUN_TEXT1, 14, 121, 168, 8
    EDITTEXT IDC_PROGRAM, 14, 131, 165, 14
    PUSHBUTTON "&Selaa...", IDC_BROWSE_PROGRAM, 180, 131, 58, 14
    LTEXT "&Komentoriviparametrit:", IDC_RUN_TEXT2, 14, 155, 108, 8
    EDITTEXT IDC_PARAMETERS, 128, 152, 110, 14
    AUTOCHECKBOX "Lisää virhemäärä komentorivin &loppuun (/fail=%1%)", IDC_ADD_FAILCOUNT, 14, 171, 219, 10, WS_CHILD | WS_VISIBLE | WS_TABSTOP | BS_TOP | BS_MULTILINE
    PUSHBUTTON "Uudelleenkäynnistyksen &asetukset...", IDC_RESTART_OPTIONS, 116, 197, 129, 14
END

IDD_DLG_DEPEND DIALOGEX 6, 6, 253, 225
CAPTION "Riippuvuudet"
FONT 8, "MS Shell Dlg", 0, 0
STYLE DS_SHELLFONT | WS_BORDER | WS_VISIBLE | WS_DLGFRAME | WS_SYSMENU | WS_GROUP | WS_TABSTOP
BEGIN
    CONTROL "", IDC_DEPEND_TREE1, "SysTreeView32" , WS_BORDER | WS_CHILDWINDOW |
            WS_VISIBLE | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES |
            TVS_LINESATROOT | TVS_DISABLEDRAGDROP, 8, 70, 236, 68
    CONTROL "", IDC_DEPEND_TREE2, "SysTreeView32", WS_BORDER | WS_CHILDWINDOW |
            WS_VISIBLE | WS_TABSTOP | TVS_HASBUTTONS | TVS_HASLINES |
            TVS_LINESATROOT | TVS_DISABLEDRAGDROP, 8, 151, 236, 68
    LTEXT "Jotkin palvelut ovat riippuvaisia muista palveluista, järjestelmäohjaimista ja latausjärjestysryhmistä. Jos järjestelmäkomponentti on pysäytetty tai se ei toimi oikein, riippuvaiset palvelut voivat häiriintyä.", IDC_STATIC, 8, 7, 238, 26
    LTEXT "&Tämä palvelu on riippuvainen seuraavista komponenteista:", IDC_STATIC, 8, 57, 236, 9
    LTEXT "&Seuraavat komponentit ovat riippuvaisia tästä palvelusta:", IDC_STATIC, 8, 140, 236, 9
    LTEXT "", IDC_DEPEND_SERVICE, 8, 38, 236, 13
END

IDD_DLG_CREATE DIALOGEX 6, 6, 225, 209
CAPTION "Luo palvelu"
FONT 8, "MS Shell Dlg", 0, 0
