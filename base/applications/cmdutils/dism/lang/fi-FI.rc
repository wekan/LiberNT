LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_HEADER "\nLevykuvien käyttöönotto- ja huoltotyökalu (DISM)\nVersio: %s\n\n"
    IDS_ERROR_DECIMAL "\nVirhe: %lu\n\n"
    IDS_ERROR_HEX "\nVirhe: 0x%08lx\n\n"
    IDS_LOG_LOCATION "\nDISM-lokitiedosto on sijainnissa %s\n"
    IDS_UNRECOGNIZED_TOKEN "DISM ei tunnista komentorivin asetusta ""%s"". \nLisätietoja saat ohjeesta suorittamalla DISM.exe /?.\n"
    IDS_UNKNOWN_OPTION "Asetus %s on tuntematon. \nLisätietoja saat ohjeesta suorittamalla DISM.exe /?.\n"
    IDS_MISSING_OPTION "Komentoriviltä puuttuu asetus %s.\nLisätietoja on ohjeessa.\n"
    IDS_OPTIONS_CONFLICT "Asetuksia %s ja %s ei voi käyttää komentorivillä yhdessä.\nLisätietoja on ohjeessa.\n"
    IDS_OPTION_REQUIRED "Komentoriviltä puuttuu pakollinen asetus.\nVarmista, että %s tai %s on määritetty.\n"
    IDS_IMAGE_NOT_FOUND "Määritettyä levykuvaa ei ole määritetyssä levykuvasäilössä.\nTarkista ensin levykuvasäilön olemassa olevat levykuvat.\n"
    IDS_INVALID_ARGUMENTS "Komennon käsittelyssä tapahtui virhe.\nVarmista, että komentorivin argumentit ovat kelvollisia. Lisätietoja on lokitiedostossa.\n"
END

