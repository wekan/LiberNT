    PUSHBUTTON      "&Kaikki käyttöön", IDC_BTN_SERVICES_ACTIVATE, 224, 156, 66, 14
    PUSHBUTTON      "Kaikki &pois", IDC_BTN_SERVICES_DEACTIVATE, 295, 156, 66, 14
    CONTROL         "&Piilota kaikki %s-palvelut", IDC_CBX_SERVICES_MASK_PROPRIETARY_SVCS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 5, 158, 203, 12
    LTEXT           "Huomaa, että joitakin suojattuja %s-palveluja ei voi poistaa käytöstä.", IDC_STATIC_SERVICES_WARNING, 5, 138, 220, 17
END

