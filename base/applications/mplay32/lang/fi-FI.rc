BEGIN
    IDS_MODE_UNKNOWN "Tuntematon"
    IDS_MODE_OPEN "Avattu"
    IDS_MODE_STOP "Pysäytetty"
    IDS_MODE_PLAY "Toistetaan"
    IDS_MODE_PAUSE "Tauko"
    IDS_MODE_RECORD "Tallennetaan"
    IDS_MODE_SEEK "Siirrytään"
    IDS_MODE_NOT_READY "Ei valmis"
    IDS_ALL_TYPES_FILTER "Kaikki tuetut"
    IDS_TOOLTIP_PLAY "Toista"
    IDS_TOOLTIP_STOP "Pysäytä"
    IDS_TOOLTIP_EJECT "Poista asemasta"
    IDS_TOOLTIP_BACKWARD "Hyppää taaksepäin"
    IDS_TOOLTIP_SEEKBACK "Kelaa taaksepäin"
    IDS_TOOLTIP_SEEKFORW "Kelaa eteenpäin"
    IDS_TOOLTIP_FORWARD "Hyppää eteenpäin"
    IDS_TOOLTIP_PAUSE "Tauko"
    IDS_APPTITLE "LiberNT-mediasoitin"
    IDS_PLAY "Toista"
    IDS_DEFAULTMCIERRMSG "Tälle virheelle ei ole kuvausta."
END
