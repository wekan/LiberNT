LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDR_MAINMENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Avaa...\tCtrl+O", IDM_OPEN_FILE
        MENUITEM "&Sulje\tCtrl+W", IDM_CLOSE_FILE
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta", IDM_EXIT
    END
    POPUP "T&oista"
    BEGIN
        MENUITEM "Toista/&Tauko\tCtrl+P", IDC_PLAY
        MENUITEM "&Pysäytä\tCtrl+S", IDC_STOP
        MENUITEM SEPARATOR
        MENUITEM "&Jatkuva toisto\tCtrl+T", IDM_REPEAT
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Yhden ikkunan tila", IDM_SWITCHVIEW
    END
    POPUP "&Laite"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "&Ominaisuudet", IDM_DEVPROPS
        MENUITEM SEPARATOR
        MENUITEM "&Äänenvoimakkuus", IDM_VOLUMECTL
    END
    POPUP "O&hje"
    BEGIN
        MENUITEM "&Tietoja", IDM_ABOUT
    END
END

ID_ACCELERATORS ACCELERATORS
BEGIN
    "^O", IDM_OPEN_FILE
    "^W", IDM_CLOSE_FILE
    "^P", IDC_PLAY
    "^S", IDC_STOP
    "^T", IDM_REPEAT
END

