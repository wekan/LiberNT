    IDS_DHCPNOADAPTER       "Toiminto epäonnistui, koska yksikään sovitin ei ole tähän toimintoon \nsallitussa tilassa.\n"
    IDS_DHCPRELEASED        "Sovittimen %ls IP-osoite on jo vapautettu.\n"
    IDS_DHCPRELEASEERROR    "Virhe vapautettaessa liittymää %ls : "
    IDS_DHCPRENEWERROR      "Virhe uusittaessa liittymää %ls : "
    IDS_DHCPSETIDERROR      "Sovittimen %ls luokkatunnuksen asettaminen epäonnistui: "
    IDS_DHCPSETIDSUCCESS    "Sovittimen %ls luokkatunnus asetettiin.\n"
END

STRINGTABLE
BEGIN
/* Please keep the spacing/formatting as per en-US.rc when translating */
    IDS_USAGE
"\nKÄYTTÖ:\n\
    ipconfig [/? | /all | /renew [sovitin] | /release [sovitin] |\n\
              /renew6 [sovitin] | /release6 [sovitin] |\n\
              /flushdns | /displaydns | /registerdns |\n\
              /showclassid sovitin |\n\
              /setclassid sovitin [luokkatunnus] ]\n\
\n\
    jossa:\n\
    sovitin         Yhteyden nimi\n\
                    (yleismerkit * ja ? sallittuja, katso esimerkit)\n\
\n\
Valinnat:\n\
    /?              Näyttää tämän ohjeen.\n\
    /all            Näyttää täydelliset määritystiedot.\n\
    /release        Vapauttaa määritetyn sovittimen IPv4-osoitteen.\n\
    /release6       Vapauttaa määritetyn sovittimen IPv6-osoitteen.\n\
    /renew          Uusii määritetyn sovittimen IPv4-osoitteen.\n\
    /renew6         Uusii määritetyn sovittimen IPv6-osoitteen.\n\
    /flushdns       Tyhjentää DNS-selvittimen välimuistin.\n\
    /registerdns    Päivittää kaikki DHCP-käyttöoikeudet ja rekisteröi DNS-nimet uudelleen.\n\
    /displaydns     Näyttää DNS-selvittimen välimuistin sisällön.\n\
    /showclassid    Näyttää kaikki sovittimelle sallitut DHCP-luokkatunnukset.\n\
    /setclassid     Muuttaa DHCP-luokkatunnusta.\n\
\n\
Oletuksena näytetään vain kunkin TCP/IP:hen sidotun sovittimen IP-osoite,\n\
aliverkon peite ja oletusyhdyskäytävä.\n\
\n\
Jos Release- ja Renew-valinnoille ei anneta sovittimen nimeä, kaikkien\n\
TCP/IP:hen sidottujen sovittimien IP-osoitteiden käyttöoikeudet vapautetaan tai uusitaan.\n\
\n\
Jos Setclassid-valinnalle ei anneta luokkatunnusta, luokkatunnus poistetaan.\n\
\n\
Esimerkkejä:\n\
    > ipconfig                   ... Näyttää tiedot.\n\
    > ipconfig /all              ... Näyttää yksityiskohtaiset tiedot\n\
    > ipconfig /renew            ... uusii kaikki sovittimet\n\
    > ipconfig /renew EL*        ... uusii kaikki yhteydet, joiden nimi\n\
                                     alkaa merkeillä EL\n\
    > ipconfig /release *Con*    ... vapauttaa kaikki vastaavat yhteydet,\n\
                                     esim. ""Local Area Connection 1""\n\
                                     tai   ""Local Area Connection 2""\n"
    IDS_CMDLINEERROR "\nVirhe: tuntematon tai puutteellinen komentorivi.\n"
END
