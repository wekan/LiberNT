    IDS_ICMP_MSG                 "  Viestit                   %-11lu %-10lu\n"
    IDS_ICMP_ERROR               "  Virheet                   %-11lu %-10lu\n"
    IDS_ICMP_DEST_UNREACH        "  Kohde ei tavoitettavissa  %-11lu %-10lu\n"
    IDS_ICMP_TIME_EXCEED         "  Aika ylitetty             %-11lu %-10lu\n"
    IDS_ICMP_PARAM_PROBLEM       "  Parametriongelmat         %-11lu %-10lu\n"
    IDS_ICMP_SRC_QUENCHES        "  Lähteen hidastuspyynnöt   %-11lu %-10lu\n"
    IDS_ICMP_REDIRECT            "  Uudelleenohjaukset        %-11lu %-10lu\n"
    IDS_ICMP_ECHO                "  Kaiutuspyynnöt            %-11lu %-10lu\n"
    IDS_ICMP_ECHO_REPLY          "  Kaiutusvastaukset         %-11lu %-10lu\n"
    IDS_ICMP_TIMESTAMP           "  Aikaleimat                %-11lu %-10lu\n"
    IDS_ICMP_TIMESTAMP_REPLY     "  Aikaleimavastaukset       %-11lu %-10lu\n"
