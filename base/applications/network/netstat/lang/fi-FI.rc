LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_USAGE "\nNäyttää TCP/IP-protokollan nykyiset tilastot ja verkkoyhteydet.\n\n\
NETSTAT [-a] [-b] [-e] [-n] [-o] [-p proto] [-r] [-s] [-t] [-v] [väli]\n\n\
  -a            Näyttää kaikki yhteydet ja kuuntelevat portit.\n\
  -b            FIXME (valitsin hyväksytään, mutta toimintoa ei ole toteutettu).\n\
  -e            Näyttää Ethernet-tilastot. Voidaan yhdistää valitsimen -s\n\
                kanssa.\n\
  -n            Näyttää osoitteet ja porttinumerot numeromuodossa.\n\
  -o            Näyttää kunkin yhteyden prosessitunnuksen.\n\
  -p proto      Näyttää protokollan 'proto' (TCP tai UDP) yhteydet.\n\
                Kun käytetään valitsimen -s kanssa protokollakohtaisten\n\
                tilastojen näyttämiseen, 'proto' voi olla TCP, UDP tai IP.\n\
  -r            Näyttää nykyisen reititystaulukon.\n\
  -s            Näyttää protokollakohtaiset tilastot. Oletusarvoisesti tilastot\n\
                näytetään protokollille IP, ICMP, TCP ja UDP;\n\
                valitsimella -p voidaan määrittää oletusten osajoukko.\n\
  -t            FIXME (valitsin hyväksytään, mutta toimintoa ei ole toteutettu).\n\
  -v            FIXME (valitsin hyväksytään, mutta toimintoa ei ole toteutettu).\n\
  väli          Näyttää valitut tilastot uudelleen 'väli' sekunnin välein.\n\
                Lopeta uudelleennäyttäminen painamalla CTRL+C. Oletusarvoisesti\n\
                netstat tulostaa nykyiset tiedot vain kerran.\n"
    IDS_DISPLAY_THEADER "\n  Proto  Paikallinen osoite     Etäosoite              Tila"
    IDS_DISPLAY_PROCESS "       Prosessi\n"
    IDS_ACTIVE_CONNECT "\nAktiiviset yhteydet\n"
END

STRINGTABLE
BEGIN
    IDS_IP4_STAT_HEADER "\nIPv4-tilastot\n\n"
    IDS_IP_PACK_REC            "  Vastaanotetut paketit              = %lu\n"
    IDS_IP_HEAD_REC_ERROR      "  Vastaanotetut otsikkovirheet       = %lu\n"
    IDS_IP_ADDR_REC_ERROR      "  Vastaanotetut osoitevirheet        = %lu\n"
    IDS_IP_DATAG_FWD           "  Edelleenlähetetyt datagrammit      = %lu\n"
    IDS_IP_UNKNOWN_PRO_REC     "  Vastaanotetut tuntemattomat prot.  = %lu\n"
    IDS_IP_REC_PACK_DISCARD    "  Hylätyt vastaanotetut paketit      = %lu\n"
    IDS_IP_REC_PACK_DELIVER    "  Toimitetut vastaanotetut paketit   = %lu\n"
    IDS_IP_OUT_REQUEST         "  Lähtevät pyynnöt                   = %lu\n"
    IDS_IP_ROUTE_DISCARD       "  Reitityksessä hylätyt              = %lu\n"
    IDS_IP_DISCARD_OUT_PACK    "  Hylätyt lähtevät paketit           = %lu\n"
    IDS_IP_OUT_PACKET_NO_ROUTE "  Lähtevät paketit ilman reittiä     = %lu\n"
    IDS_IP_REASSEMBLE_REQUIRED "  Uudelleenkoonti tarpeen            = %lu\n"
    IDS_IP_REASSEMBLE_SUCCESS  "  Onnistuneet uudelleenkoonnit       = %lu\n"
    IDS_IP_REASSEMBLE_FAILURE  "  Epäonnistuneet uudelleenkoonnit    = %lu\n"
    IDS_IP_DATAG_FRAG_SUCCESS  "  Onnistuneesti pilkotut datagrammit = %lu\n"
    IDS_IP_DATAG_FRAG_FAILURE  "  Epäonnistuneet pilkkomiset         = %lu\n"
    IDS_IP_DATAG_FRAG_CREATE   "  Luodut fragmentit                  = %lu\n"
END

