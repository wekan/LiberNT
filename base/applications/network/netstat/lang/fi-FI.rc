    IDS_ETHERNET_THEADER            "                           Vastaanotettu       Lähetetty\n\n"
    IDS_ETHERNET_BYTES              "Tavut                %14lu %15lu\n"
    IDS_ETHERNET_UNICAST_PACKET     "Unicast-paketit      %14lu %15lu\n"
    IDS_ETHERNET_NON_UNICAST_PACKET "Muut kuin unicast    %14lu %15lu\n"
    IDS_ETHERNET_DISCARD            "Hylätyt              %14lu %15lu\n"
    IDS_ETHERNET_ERROR              "Virheet              %14lu %15lu\n"
    IDS_ETHERNET_UNKNOWN            "Tuntemattomat prot.  %14lu\n"
