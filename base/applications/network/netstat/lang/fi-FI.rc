STRINGTABLE
BEGIN
    IDS_ERROR_WSA_START "VIRHE: WSAStartup() epäonnistui: %d\n"
    IDS_ERROR_ROUTE "VIRHE: Tiedostoa 'route.exe' ei löydy\n"
    IDS_ERROR_TCP_SNAPSHOT "VIRHE: TCP-päätepisteiden tilannevedos epäonnistui.\n"
    IDS_ERROR_UDP_ENDPOINT "VIRHE: UDP-päätepisteiden tilannevedos epäonnistui.\n"
    IDS_ERROR_UDP_ENDPOINT_TABLE "VIRHE: UDP-päätepistetaulukon tilannevedos epäonnistui.\n"
