STRINGTABLE
BEGIN
    IDS_APP_TITLE "Tehtävienhallinta"
    IDC_TASKMGR "Tehtävienhallinta"
    IDS_IDLE_PROCESS "Järjestelmän joutoprosessi"
END

STRINGTABLE
BEGIN
    ID_FILE_NEW "Suorittaa uuden ohjelman"
    ID_OPTIONS_ALWAYSONTOP "Tehtävienhallinta pysyy kaikkien muiden ikkunoiden edessä, ellei sitä pienennetä"
    ID_OPTIONS_MINIMIZEONUSE "Tehtävienhallinta pienennetään, kun tehtävään siirrytään"
    ID_OPTIONS_HIDEWHENMINIMIZED "Piilota Tehtävienhallinta, kun se pienennetään"
    ID_VIEW_REFRESH "Pakota Tehtävienhallinta päivittymään heti päivitysnopeuden asetuksesta riippumatta"
