LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDR_TASKMANAGER MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Uusi tehtävä (Suorita...)", ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Lopeta Tehtävienhallinta", ID_FILE_EXIT
    END
    POPUP "&Asetukset"
    BEGIN
        MENUITEM "&Aina päällimmäisenä", ID_OPTIONS_ALWAYSONTOP, CHECKED
        MENUITEM "Pie&nennä käytettäessä", ID_OPTIONS_MINIMIZEONUSE, CHECKED
        MENUITEM "&Piilota pienennettynä", ID_OPTIONS_HIDEWHENMINIMIZED, CHECKED
        MENUITEM "", ID_OPTIONS_SHOW16BITTASKS, CHECKED
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Päivitä nyt", ID_VIEW_REFRESH
        POPUP "Päivitys&nopeus"
        BEGIN
            MENUITEM "&Korkea", ID_VIEW_UPDATESPEED_HIGH
            MENUITEM "&Normaali", ID_VIEW_UPDATESPEED_NORMAL, CHECKED
            MENUITEM "&Matala", ID_VIEW_UPDATESPEED_LOW
            MENUITEM "K&eskeytetty", ID_VIEW_UPDATESPEED_PAUSED
        END
        MENUITEM SEPARATOR
        MENUITEM "", ID_VIEW_LARGE
        MENUITEM "", ID_VIEW_SMALL
        MENUITEM "", ID_VIEW_DETAILS, CHECKED
        MENUITEM "", ID_VIEW_SELECTCOLUMNS
        POPUP ""
        BEGIN
            MENUITEM "", ID_VIEW_CPUHISTORY_ONEGRAPHALL
            MENUITEM "", ID_VIEW_CPUHISTORY_ONEGRAPHPERCPU, CHECKED
        END
        MENUITEM "", ID_VIEW_SHOWKERNELTIMES
    END
    POPUP ""
    BEGIN
        MENUITEM "Vierekkäin &vaakasuunnassa", ID_WINDOWS_TILEHORIZONTALLY
        MENUITEM "Vierekkäin &pystysuunnassa", ID_WINDOWS_TILEVERTICALLY
        MENUITEM "P&ienennä", ID_WINDOWS_MINIMIZE
        MENUITEM "&Suurenna", ID_WINDOWS_MAXIMIZE
        MENUITEM "&Limittäin", ID_WINDOWS_CASCADE
        MENUITEM "&Tuo eteen", ID_WINDOWS_BRINGTOFRONT
    END
    POPUP "&Sammuta"
    BEGIN
        MENUITEM "&Valmiustila", ID_SHUTDOWN_STANDBY
        MENUITEM "&Horrostila", ID_SHUTDOWN_HIBERNATE
        MENUITEM "&Sammuta", ID_SHUTDOWN_POWEROFF
        MENUITEM "&Käynnistä uudelleen", ID_SHUTDOWN_REBOOT
        MENUITEM "Kirjaa &ulos %s", ID_SHUTDOWN_LOGOFF
        MENUITEM "V&aihda käyttäjää\tWinKey+L", ID_SHUTDOWN_SWITCHUSER, GRAYED
        MENUITEM "&Lukitse tietokone\tWinKey+L", ID_SHUTDOWN_LOCKCOMPUTER
        MENUITEM "Ka&tkaise yhteys", ID_SHUTDOWN_DISCONNECT, GRAYED
        MENUITEM "&Poista tietokone telakasta", ID_SHUTDOWN_EJECT_COMPUTER, GRAYED
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "Tehtävienhallinnan &ohjeaiheet", ID_HELP_TOPICS
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja Tehtävienhallinnasta", ID_HELP_ABOUT
    END
END

IDR_WINDOWSMENU MENU
BEGIN
    MENUITEM "Vierekkäin &vaakasuunnassa", ID_WINDOWS_TILEHORIZONTALLY
    MENUITEM "Vierekkäin &pystysuunnassa", ID_WINDOWS_TILEVERTICALLY
    MENUITEM "P&ienennä", ID_WINDOWS_MINIMIZE
    MENUITEM "&Suurenna", ID_WINDOWS_MAXIMIZE
    MENUITEM "&Limittäin", ID_WINDOWS_CASCADE
    MENUITEM "&Tuo eteen", ID_WINDOWS_BRINGTOFRONT
END

IDR_APPLICATION_PAGE_CONTEXT1 MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Uusi tehtävä (Suorita...)", ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Suuret kuvakkeet", ID_VIEW_LARGE
        MENUITEM "Pi&enet kuvakkeet", ID_VIEW_SMALL
        MENUITEM "&Tiedot", ID_VIEW_DETAILS, CHECKED
    END
END

IDR_APPLICATION_PAGE_CONTEXT2 MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Siirr&y tehtävään", ID_APPLICATION_PAGE_SWITCHTO
        MENUITEM "&Tuo eteen", ID_WINDOWS_BRINGTOFRONT
        MENUITEM SEPARATOR
        MENUITEM "Vierekkäin &vaakasuunnassa", ID_WINDOWS_TILEHORIZONTALLY
        MENUITEM "Vierekkäin &pystysuunnassa", ID_WINDOWS_TILEVERTICALLY
        MENUITEM "P&ienennä", ID_WINDOWS_MINIMIZE
        MENUITEM "&Suurenna", ID_WINDOWS_MAXIMIZE
        MENUITEM "&Limittäin", ID_WINDOWS_CASCADE
        MENUITEM SEPARATOR
        MENUITEM "Lopeta t&ehtävä", ID_APPLICATION_PAGE_ENDTASK
        MENUITEM "Siirry pr&osessiin", ID_APPLICATION_PAGE_GOTOPROCESS
    END
END

IDR_TRAY_POPUP MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Palauta", ID_RESTORE
        MENUITEM "&Sulje", ID_FILE_EXIT
        MENUITEM SEPARATOR
        MENUITEM "&Aina päällimmäisenä", ID_OPTIONS_ALWAYSONTOP
    END
END

IDR_PROCESS_PAGE_CONTEXT MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Lopeta prosessi", ID_PROCESS_PAGE_ENDPROCESS
        MENUITEM "Lopeta prosessi&puu", ID_PROCESS_PAGE_ENDPROCESSTREE
        MENUITEM "&Virheenkorjaus", ID_PROCESS_PAGE_DEBUG
        MENUITEM SEPARATOR
        POPUP "Aseta p&rioriteetti"
        BEGIN
            MENUITEM "&Reaaliaikainen", ID_PROCESS_PAGE_SETPRIORITY_REALTIME
            MENUITEM "&Korkea", ID_PROCESS_PAGE_SETPRIORITY_HIGH
            MENUITEM "Normaalia k&orkeampi", ID_PROCESS_PAGE_SETPRIORITY_ABOVENORMAL
            MENUITEM "&Normaali", ID_PROCESS_PAGE_SETPRIORITY_NORMAL
            MENUITEM "Normaalia &alempi", ID_PROCESS_PAGE_SETPRIORITY_BELOWNORMAL
            MENUITEM "&Matala", ID_PROCESS_PAGE_SETPRIORITY_LOW
        END
        MENUITEM "Aseta &suoritinaffiniteetti...", ID_PROCESS_PAGE_SETAFFINITY
        MENUITEM SEPARATOR
        MENUITEM "&Ominaisuudet", ID_PROCESS_PAGE_PROPERTIES
        MENUITEM "Avaa &tiedoston sijainti", ID_PROCESS_PAGE_OPENFILELOCATION
    END
END

/* Dialogs */

/* TRANSLATORS: CAPTION must be the same as IDS_APP_TITLE to be brought back to focus when already opened */

IDD_TASKMGR_DIALOG DIALOGEX 0, 0, 264, 246
STYLE DS_SHELLFONT | DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP |
      WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Tehtävienhallinta"
MENU IDR_TASKMANAGER
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_TAB, "SysTabControl32", WS_TABSTOP, 3, 3, 257, 228
END

IDD_APPLICATION_PAGE DIALOGEX 0, 0, 247, 210
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_APPLIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS |
            WS_BORDER | WS_TABSTOP, 5, 7, 235, 177
    PUSHBUTTON "Lopeta t&ehtävä", IDC_ENDTASK, 75, 189, 53, 14, WS_DISABLED
    PUSHBUTTON "Siirr&y tehtävään", IDC_SWITCHTO, 131, 189, 53, 14, WS_DISABLED
    PUSHBUTTON "&Uusi tehtävä...", IDC_NEWTASK, 187, 189, 53, 14
END

IDD_PROCESS_PAGE DIALOGEX 0, 0, 247, 210
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_PROCESSLIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL |
            LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 5, 7, 235, 177
    AUTOCHECKBOX "&Näytä kaikkien käyttäjien prosessit", IDC_SHOWALLPROCESSES, 5, 191, 111, 10
    PUSHBUTTON "&Lopeta prosessi", IDC_ENDPROCESS, 171, 189, 69, 14
END

IDD_PERFORMANCE_PAGE DIALOGEX 0, 0, 247, 210
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Suorittimen käyttö", IDC_CPU_USAGE_FRAME, 5, 5, 60, 54, 0, WS_EX_TRANSPARENT
    GROUPBOX "Muistin käyttö", IDC_MEM_USAGE_FRAME, 5, 63, 60, 54, BS_LEFTTEXT, WS_EX_TRANSPARENT
