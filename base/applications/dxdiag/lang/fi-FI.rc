LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_MAIN_DIALOG DIALOGEX 0, 0, 478, 280
STYLE DS_SHELLFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP |
      WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU
CAPTION "ReactX-diagnostiikkatyökalu"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "Tab1", IDC_TAB_CONTROL, "SysTabControl32", WS_TABSTOP, 2, 2, 474, 250
    PUSHBUTTON "&Ohje", IDC_BUTTON_HELP, 2, 260, 50, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_DISABLED
    DEFPUSHBUTTON "&Seuraava sivu", IDC_BUTTON_NEXT, 257, 260, 50, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
    PUSHBUTTON "&Tallenna kaikki tiedot...", IDC_BUTTON_SAVE_INFO, 311, 260, 110, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_DISABLED
    PUSHBUTTON "&Lopeta", IDC_BUTTON_EXIT, 425, 260, 50, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END

IDD_SYSTEM_DIALOG DIALOGEX 0, 0, 462, 220
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Tämä työkalu näyttää yksityiskohtaisia tietoja järjestelmään asennetuista ReactX-komponenteista ja -ohjaimista.", IDC_STATIC, 5, 0, 443, 17
    LTEXT "Jos sinulla on ReactX-ongelma ja tiedät, mikä se on, valitse sitä vastaava välilehti yllä. Muussa tapauksessa voit käydä sivut läpi järjestyksessä alla olevalla ""Seuraava sivu"" -painikkeella.", IDC_STATIC, 5, 15, 443, 25
    GROUPBOX "Järjestelmätiedot", IDC_STATIC, 5, 35, 452, 150, SS_RIGHT
    LTEXT "Päivämäärä ja aika:", IDC_STATIC, 70, 50, 80, 10, SS_RIGHT
    LTEXT "Tietokoneen nimi:", IDC_STATIC, 70, 60, 80, 10, SS_RIGHT
    LTEXT "Käyttöjärjestelmä:", IDC_STATIC, 70, 70, 80, 10, SS_RIGHT
    LTEXT "Kieli:", IDC_STATIC, 70, 80, 80, 10, SS_RIGHT
    LTEXT "Järjestelmän valmistaja:", IDC_STATIC, 70, 90, 80, 10, SS_RIGHT
    LTEXT "Järjestelmän malli:", IDC_STATIC, 70, 100, 80, 10, SS_RIGHT
    LTEXT "BIOS:", IDC_STATIC, 70, 110, 80, 10, SS_RIGHT
    LTEXT "Suoritin:", IDC_STATIC, 70, 120, 80, 10, SS_RIGHT
    LTEXT "Muisti:", IDC_STATIC, 70, 130, 80, 10, SS_RIGHT
    LTEXT "Sivutustiedosto:", IDC_STATIC, 70, 140, 80, 10, SS_RIGHT
    LTEXT "ReactX-versio:", IDC_STATIC, 70, 150, 80, 10, SS_RIGHT
    EDITTEXT IDC_STATIC_TIME, 155, 50, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_COMPUTER, 155, 60, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_OS, 155, 70, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_LANG, 155, 80, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_MANU, 155, 90, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_MODEL, 155, 100, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_BIOS, 155, 110, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_PROC, 155, 120, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_MEM, 155, 130, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_SWAP, 155, 140, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    EDITTEXT IDC_STATIC_VERSION, 155, 150, 210, 10, ES_LEFT | ES_READONLY | NOT WS_BORDER | NOT WS_TABSTOP | ES_AUTOHSCROLL
    CHECKBOX "Tarkista WHQL-digitaaliset allekirjoitukset", IDC_WHQL_SIGN_CHECK, 15, 170, 135, 10, WS_DISABLED
END

