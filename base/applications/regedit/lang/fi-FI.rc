/* Dialogs */

IDD_EXPORTRANGE DIALOGEX 50, 50, 370, 50
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS | WS_BORDER
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Vientialue", IDC_STATIC, 2, 0, 366, 48
    AUTORADIOBUTTON "&Kaikki", IDC_EXPORT_ALL, 10, 10, 99, 11, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Valittu haara", IDC_EXPORT_BRANCH, 10, 22, 99, 11
    EDITTEXT IDC_EXPORT_BRANCH_TEXT, 30, 34, 335, 12
END

IDD_LOADHIVE DIALOGEX 0, 0, 193, 34
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lataa rekisterihaara"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "&Avain:", IDC_STATIC, 4, 4, 15, 8, SS_LEFT
    EDITTEXT IDC_EDIT_KEY, 23, 2, 167, 13
    DEFPUSHBUTTON "OK", IDOK, 140, 17, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 89, 17, 50, 14
END

IDD_ADDFAVORITES DIALOGEX 0, 0, 186, 46
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Lisää suosikkeihin"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 129, 7, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 129, 24, 50, 14
    LTEXT "&Suosikin nimi:", IDC_STATIC, 7, 7, 70, 10
    EDITTEXT IDC_FAVORITENAME, 7, 26, 110, 13, ES_AUTOHSCROLL
END

IDD_REMOVEFAVORITES DIALOGEX 0, 0, 164, 135
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Poista suosikit"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 107, 114, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 7, 114, 50, 14
    CONTROL "", IDC_FAVORITESLIST, "SysListView32", LVS_LIST | WS_BORDER |
            WS_TABSTOP, 7, 20, 150, 90
    LTEXT "Valitse suosikit:", IDC_STATIC, 7, 7, 99, 12
END

IDD_FIND DIALOGEX 0, 0, 254, 82
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Etsi"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "&Etsi seuraava", IDOK, 197, 7, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 197, 24, 50, 14
    GROUPBOX "Kohde", IDC_STATIC, 7, 25, 63, 51
    LTEXT "E&tsittävä:", IDC_STATIC, 7, 8, 37, 10
    EDITTEXT IDC_FINDWHAT, 47, 7, 142, 13, ES_AUTOHSCROLL
    CONTROL "&Avaimet", IDC_LOOKAT_KEYS, "Button", BS_AUTOCHECKBOX |
            WS_TABSTOP, 14, 36, 35, 8
    CONTROL "A&rvot", IDC_LOOKAT_VALUES, "Button", BS_AUTOCHECKBOX |
            WS_TABSTOP, 14, 48, 36, 8
    CONTROL "&Tiedot", IDC_LOOKAT_DATA, "Button", BS_AUTOCHECKBOX |
            WS_TABSTOP, 14, 60, 42, 8
    CONTROL "&Vain koko merkkijono", IDC_MATCHSTRING, "Button", BS_AUTOCHECKBOX |
            WS_TABSTOP, 83, 32, 94, 13
    CONTROL "Sama &kirjainkoko", IDC_MATCHCASE, "Button", BS_AUTOCHECKBOX |
            WS_TABSTOP, 83, 48, 90, 12
END

IDD_FINDING DIALOGEX 0, 0, 145, 50
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Etsi"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON IDI_REGEDIT, IDC_STATIC, 7, 7, 20, 20
    DEFPUSHBUTTON "Peruuta", IDCANCEL, 93, 29, 45, 14
    LTEXT "Haetaan rekisteristä...", IDC_STATIC, 33, 12, 83, 8
END
