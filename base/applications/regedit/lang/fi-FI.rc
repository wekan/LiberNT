LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

ID_ACCEL ACCELERATORS
BEGIN
    "D", ID_ADDRESS_FOCUS, VIRTKEY, ALT
    VK_DELETE, ID_EDIT_DELETE, VIRTKEY, NOINVERT
    "^F", ID_EDIT_FIND
    VK_F1, ID_HELP_HELPTOPICS, VIRTKEY, NOINVERT
    VK_F2, ID_EDIT_RENAME, VIRTKEY, NOINVERT
    VK_F3, ID_EDIT_FINDNEXT, VIRTKEY, NOINVERT
    VK_F4, ID_ADDRESS_FOCUS, VIRTKEY, NOINVERT
    VK_F5, ID_VIEW_REFRESH, VIRTKEY, NOINVERT
END

/* Command-line strings */
STRINGTABLE
BEGIN
    STRING_USAGE "Käyttö:\n\
  regedit [valitsimet] [tiedostonimi] [rekisteriavain]\n\n\
Valitsimet:\n\
  [ei valitsinta] Käynnistää ohjelman graafisen version.\n\
  /L:system.dat  Muokattavan system.dat-tiedoston sijainti.\n\
                 Yhteensopiva kaikkien valitsimien kanssa. Ohitetaan.\n\
  /R:user.dat    Muokattavan user.dat-tiedoston sijainti.\n\
                 Yhteensopiva kaikkien valitsimien kanssa. Ohitetaan.\n\
  /C             Tuo rekisteritiedoston sisällön.\n\
  /D             Poistaa määritetyn rekisteriavaimen.\n\
  /E             Vie määritetyn rekisteriavaimen sisällön tiedostoon.\n\
                 Jos avainta ei määritetä, koko rekisteri viedään.\n\
  /S             Hiljainen tila. Viestejä ei näytetä.\n\
  /V             Käynnistää graafisen liittymän lisätilassa. Ohitetaan.\n\
  /?             Näyttää nämä tiedot ja lopettaa.\n\
  [tiedostonimi] Tuotavat rekisteritiedot sisältävän tiedoston\n\
                 sijainti. [/E]:n kanssa tämä valitsin määrittää tiedoston,\n\
                 johon rekisteritiedot viedään.\n\
  [rekisteriavain] Muokattava rekisteriavain.\n\
\n\
Käyttöesimerkkejä:\n\
  regedit ""import.reg""\n\
  regedit /E ""export.reg"" ""HKEY_CURRENT_USER\\Console""\n\
  regedit /D ""HKEY_LOCAL_MACHINE\\Error\\Path""\n"
    STRING_INVALID_SWITCH "regedit: Virheellinen tai tuntematon valitsin [%1]\n"
    STRING_HELP "Saat ohjeita kirjoittamalla ""regedit /?"".\n"
    STRING_NO_FILENAME "regedit: Tiedostonimeä ei määritetty.\n"
    STRING_NO_REG_KEY "regedit: Poistettavaa rekisteriavainta ei määritetty.\n"
    STRING_FILE_NOT_FOUND "regedit: Tiedostoa '%1' ei löytynyt.\n"
    STRING_CANNOT_OPEN_FILE "regedit: Tiedostoa '%1' ei voi avata.\n"
    STRING_UNHANDLED_ACTION "regedit: Käsittelemätön toiminto.\n"
    STRING_OUT_OF_MEMORY "regedit: Muisti loppui! (%1!S!, rivi %2!u!)\n"
    STRING_INVALID_HEX "regedit: Virheellinen heksadesimaaliarvo.\n"
    STRING_CSV_HEX_ERROR "regedit: Heksadesimaalitietoja ei voi muuntaa. Kohdassa '%1' on virheellinen arvo.\n"
    STRING_ESCAPE_SEQUENCE "regedit: Tuntematon ohjausmerkkijono [\\%1!c!]\n"
    STRING_UNKNOWN_DATA_FORMAT "regedit: Rekisterin tietotyyppiä ei tueta [0x%1!x!]\n"
    STRING_UNEXPECTED_EOL "regedit: Odottamaton rivin loppu kohteessa '%1'.\n"
    STRING_UNRECOGNIZED_LINE "regedit: Riviä '%1' ei tunnistettu.\n"
    STRING_SETVALUE_FAILED "regedit: Rekisteriarvoa '%1' ei voi lisätä kohteeseen '%2'.\n"
    STRING_OPEN_KEY_FAILED "regedit: Rekisteriavainta '%1' ei voi avata.\n"
    STRING_UNSUPPORTED_TYPE "regedit: Kohteessa '%2' on rekisterin tietotyyppi, jota ei tueta [0x%1!x!].\n"
    STRING_EXPORT_AS_BINARY "regedit: Rekisteriarvo '%1' viedään binaaritietoina.\n"
    STRING_INVALID_SYSTEM_KEY "regedit: Virheellinen järjestelmäavain [%1]\n"
    STRING_REG_KEY_NOT_FOUND "regedit: Kohdetta '%1' ei voi viedä. Määritettyä rekisteriavainta ei löytynyt.\n"
    STRING_DELETE_FAILED "regedit: Rekisteriavainta '%1' ei voi poistaa.\n"
    STRING_UNKNOWN_TYPE "Tuntematon tyyppi"
    STRING_INVALID_LINE_SYNTAX, "regedit: Rivin syntaksi on virheellinen.\n"
END

/* Menus */

IDR_REGEDIT_MENU MENU
BEGIN
    POPUP "&Tiedosto"
    BEGIN
        MENUITEM "&Tuo...", ID_REGISTRY_IMPORTREGISTRYFILE
        MENUITEM "&Vie...", ID_REGISTRY_EXPORTREGISTRYFILE
        MENUITEM SEPARATOR
        MENUITEM "&Lataa rekisterihaara...", ID_REGISTRY_LOADHIVE, GRAYED
        MENUITEM "&Poista rekisterihaaran lataus...", ID_REGISTRY_UNLOADHIVE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Yhdistä verkkorekisteriin...", ID_REGISTRY_CONNECTNETWORKREGISTRY
        MENUITEM "&Katkaise verkkorekisteriyhteys...", ID_REGISTRY_DISCONNECTNETWORKREGISTRY, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "T&ulosta...\tCtrl+P", ID_REGISTRY_PRINT, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "L&opeta", ID_REGISTRY_EXIT
    END
    POPUP "&Muokkaa"
    BEGIN
        MENUITEM "&Muokkaa", ID_EDIT_MODIFY
        MENUITEM SEPARATOR
        POPUP "&Uusi"
        BEGIN
            MENUITEM "&Avain", ID_EDIT_NEW_KEY
            MENUITEM SEPARATOR
            MENUITEM "&Merkkijonoarvo", ID_EDIT_NEW_STRINGVALUE
            MENUITEM "&Binaariarvo", ID_EDIT_NEW_BINARYVALUE
            MENUITEM "&DWORD-arvo", ID_EDIT_NEW_DWORDVALUE
            MENUITEM "M&onimerkkijonoarvo", ID_EDIT_NEW_MULTISTRINGVALUE
            MENUITEM "&Laajennettava merkkijonoarvo", ID_EDIT_NEW_EXPANDABLESTRINGVALUE
        END
        MENUITEM SEPARATOR
        MENUITEM "&Käyttöoikeudet...", ID_EDIT_PERMISSIONS
        MENUITEM SEPARATOR
        MENUITEM "&Poista\tDel", ID_EDIT_DELETE
        MENUITEM "&Nimeä uudelleen", ID_EDIT_RENAME
        MENUITEM SEPARATOR
        MENUITEM "K&opioi avaimen nimi", ID_EDIT_COPYKEYNAME
        MENUITEM SEPARATOR
        MENUITEM "&Etsi...\tCtrl+F", ID_EDIT_FIND
        MENUITEM "Etsi &seuraava\tF3", ID_EDIT_FINDNEXT
    END
    POPUP "&Näytä"
    BEGIN
        MENUITEM "&Tilarivi", ID_VIEW_STATUSBAR
        MENUITEM SEPARATOR
        MENUITEM "&Jako", ID_VIEW_SPLIT
        MENUITEM SEPARATOR
        MENUITEM "&Päivitä\tF5", ID_VIEW_REFRESH
    END
    POPUP "&Suosikit"
    BEGIN
        MENUITEM "&Lisää suosikkeihin", ID_FAVOURITES_ADDTOFAVOURITES, GRAYED
        MENUITEM "&Poista suosikki", ID_FAVOURITES_REMOVEFAVOURITE, GRAYED
    END
    POPUP "&Ohje"
    BEGIN
        MENUITEM "&Ohjeen aiheet\tF1", ID_HELP_HELPTOPICS
        MENUITEM SEPARATOR
        MENUITEM "&Tietoja Rekisterieditorista", ID_HELP_ABOUT
    END
END

IDR_POPUP_MENUS MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Muokkaa", ID_EDIT_MODIFY
        MENUITEM "Muokkaa binaaritietoja", ID_EDIT_MODIFY_BIN
        MENUITEM SEPARATOR
        MENUITEM "&Poista\tDel", ID_EDIT_DELETE
        MENUITEM "&Nimeä uudelleen", ID_EDIT_RENAME
    END
    POPUP ""
    BEGIN
        POPUP "&Uusi"
        BEGIN
            MENUITEM "&Avain", ID_EDIT_NEW_KEY
            MENUITEM SEPARATOR
            MENUITEM "&Merkkijonoarvo", ID_EDIT_NEW_STRINGVALUE
            MENUITEM "&Binaariarvo", ID_EDIT_NEW_BINARYVALUE
            MENUITEM "&DWORD-arvo", ID_EDIT_NEW_DWORDVALUE
            MENUITEM "M&onimerkkijonoarvo", ID_EDIT_NEW_MULTISTRINGVALUE
            MENUITEM "&Laajennettava merkkijonoarvo", ID_EDIT_NEW_EXPANDABLESTRINGVALUE
        END
    END
    POPUP ""
    BEGIN
        MENUITEM "Laajenna/kutista", ID_TREE_EXPANDBRANCH
        POPUP "&Uusi"
        BEGIN
            MENUITEM "&Avain", ID_EDIT_NEW_KEY
            MENUITEM SEPARATOR
            MENUITEM "&Merkkijonoarvo", ID_EDIT_NEW_STRINGVALUE
            MENUITEM "&Binaariarvo", ID_EDIT_NEW_BINARYVALUE
            MENUITEM "&DWORD-arvo", ID_EDIT_NEW_DWORDVALUE
            MENUITEM "M&onimerkkijonoarvo", ID_EDIT_NEW_MULTISTRINGVALUE
            MENUITEM "&Laajennettava merkkijonoarvo", ID_EDIT_NEW_EXPANDABLESTRINGVALUE
        END
        MENUITEM "&Etsi...", ID_EDIT_FIND
        MENUITEM SEPARATOR
        MENUITEM "&Poista", ID_TREE_DELETE
        MENUITEM "&Nimeä uudelleen", ID_TREE_RENAME
        MENUITEM SEPARATOR
        MENUITEM "&Vie", ID_TREE_EXPORT
        MENUITEM "&Käyttöoikeudet...", ID_TREE_PERMISSIONS
        MENUITEM SEPARATOR
        MENUITEM "K&opioi avaimen nimi", ID_EDIT_COPYKEYNAME
    END
    POPUP ""
    BEGIN
        MENUITEM "Laajenna/kutista", ID_TREE_EXPANDBRANCH
        MENUITEM SEPARATOR
        MENUITEM "&Vie", ID_TREE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "Poista rekisterihaaran lataus...", ID_REGISTRY_UNLOADHIVE, GRAYED
    END
    POPUP ""
    BEGIN
        MENUITEM "&Leikkaa", ID_HEXEDIT_CUT
        MENUITEM "&Kopioi", ID_HEXEDIT_COPY
        MENUITEM "L&iitä", ID_HEXEDIT_PASTE
        MENUITEM "&Poista", ID_HEXEDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Valitse kaikki", ID_HEXEDIT_SELECT_ALL
    END
END

/* Dialogs */

IDD_EDIT_STRING DIALOGEX 32, 24, 252, 84
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_NOIDLEMSG | DS_CONTEXTHELP | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Muokkaa merkkijonoa"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Arvon &nimi:", IDC_STATIC, 6, 6, 134, 8
    EDITTEXT IDC_VALUE_NAME, 6, 17, 240, 12, ES_AUTOHSCROLL | ES_READONLY
    LTEXT "&Arvotiedot:", IDC_STATIC, 6, 35, 161, 8
    EDITTEXT IDC_VALUE_DATA, 6, 46, 240, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 142, 64, 50, 14
    PUSHBUTTON "Peruuta", IDCANCEL, 196, 64, 50, 14
END

