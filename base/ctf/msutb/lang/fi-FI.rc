LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_OK               "OK"
    IDS_CANCEL           "Peruuta"
    IDS_ABORT            "&Keskeytä"
    IDS_RETRY            "&Yritä uudelleen"
    IDS_IGNORE           "&Ohita"
    IDS_YES              "&Kyllä"
    IDS_NO               "&Ei"

    IDS_SETTINGS         "&Asetukset..."
    IDS_RESTORELANGBAR   "Palauta kielipalkki"
    IDS_LANGUAGE         "Kieli"
    IDS_LANGUAGEBUTTON   "Kielipainike"
    IDS_TRANSPARENCY     "&Läpinäkyvyys"
    IDS_TEXTLABELS       "&Tekstiotsikot"
    IDS_MINIMIZE         "&Pienennä"
    IDS_CLOSELANGBAR     "&Sulje kielipalkki"
    IDS_EXTRAICONS       "&Lisäkuvakkeet tehtäväpalkissa"
    IDS_LANGUAGEBAR      "Kielipalkki"
    IDS_RESTORELANGBAR2  "&Palauta kielipalkki"
    IDS_MENUWND          "Valikkoikkuna"
    IDS_VERTICAL         "P&ystysuuntainen"
    IDS_ADJUSTLANGBAND   "&Säädä kielinauhan sijaintia"
    IDS_LEFTCLICK        "Vasen napsautus"
END

IDD_CLOSELANGBARNOBAND DIALOGEX 0, 0, 200, 105
CAPTION "Kielipalkki"
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_MODALFRAME
FONT 8, "MS Shell Dlg"
{
    LTEXT "Olet sulkenut kielipalkin.\r\n\r\nJos haluat käyttää kielipalkkia myöhemmin, valitse ""Näytä kielipalkki työpöydällä"" kielipalkin Asetukset-valintaikkunasta, jonka löydät Tekstipalvelut-ohjauspaneelista.", -1, 5, 5, 190, 60
    AUTOCHECKBOX "Ä&lä näytä tätä viestiä uudelleen", IDC_CLOSELANGBAR_CHECK, 5, 70, 145, 10
    DEFPUSHBUTTON "OK", IDOK, 80, 85, 55, 15
    PUSHBUTTON "Peruuta", IDCANCEL, 140, 85, 55, 15
}

IDD_CLOSELANGBAR DIALOGEX 0, 0, 200, 105
CAPTION "Kielipalkki"
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_MODALFRAME
FONT 8, "MS Shell Dlg"
{
    LTEXT "Olet sulkenut kielipalkin.\r\n\r\nJos haluat käyttää kielipalkkia myöhemmin, valitse ""Näytä kielipalkki työpöydällä"" kielipalkin Asetukset-valintaikkunasta, jonka löydät Alue- ja kieliasetukset -ohjauspaneelista.", -1, 5, 5, 190, 60
    AUTOCHECKBOX "Ä&lä näytä tätä viestiä uudelleen", IDC_CLOSELANGBAR_CHECK, 5, 70, 145, 10
    DEFPUSHBUTTON "OK", IDOK, 80, 85, 55, 15
    PUSHBUTTON "Peruuta", IDCANCEL, 140, 85, 55, 15
}

IDD_MINIMIZELANGBARNOBAND DIALOGEX 0, 0, 205, 124
CAPTION "Kielipalkki"
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_MODALFRAME
FONT 8, "MS Shell Dlg"
{
    LTEXT "Olet pienentänyt kielipalkin. Voit palauttaa sen napsauttamalla kielipalkin kuvaketta (kellon vieressä) ja valitsemalla ponnahdusvalikosta ""Palauta kielipalkki"".", -1, 5, 5, 190, 50
    CONTROL IDB_BITMAP154, -1, "STATIC", SS_BITMAP, 72, 63, 60, 60, WS_EX_STATICEDGE
    AUTOCHECKBOX "Älä näytä tätä viestiä uudelleen", IDC_MINIMIZELANGBAR_CHECK, 5, 95, 142, 10
    DEFPUSHBUTTON "OK", IDOK, 140, 105, 60, 15
}

IDD_MINIMIZELANGBAR DIALOGEX 0, 0, 205, 124
CAPTION "Kielipalkki"
STYLE WS_POPUPWINDOW | WS_CAPTION | DS_MODALFRAME
FONT 8, "MS Shell Dlg"
{
    LTEXT "Olet pienentänyt kielipalkin. Voit palauttaa sen napsauttamalla kielipalkin kuvaketta (kellon vieressä) ja valitsemalla ponnahdusvalikosta ""Palauta kielipalkki"".", -1, 5, 5, 190, 50
    CONTROL IDB_BITMAP155, -1, "STATIC", SS_BITMAP, 53, 67, 60, 60, WS_EX_STATICEDGE
    AUTOCHECKBOX "Älä näytä tätä viestiä uudelleen", IDC_MINIMIZELANGBAR_CHECK, 5, 95, 142, 10
    DEFPUSHBUTTON "OK", IDOK, 140, 105, 60, 15
}
