LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

IDD_RECOVERY DIALOGEX 0, 0, 260, 64
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_VISIBLE
EXSTYLE WS_EX_TOPMOST
CAPTION "Windowsin virheraportointi"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_RECOVERY_TEXT, 8, 8, 244, 28
    PUSHBUTTON "Peruuta", IDCANCEL, 202, 42, 50, 14
END

STRINGTABLE
BEGIN
    IDS_RECOVERING "Palautetaan tietojasi kohteesta %s..."
    IDS_CANCELLING "Perutaan kohteen %s palautusta..."
END
