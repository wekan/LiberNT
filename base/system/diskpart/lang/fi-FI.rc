LANGUAGE LANG_FINNISH, SUBLANG_DEFAULT

/* Basic application information */
STRINGTABLE
BEGIN
    IDS_APP_HEADER "LiberNT DiskPart"
    IDS_APP_USAGE "\nLevyjen osiointitulkki.\n\n\
Käyttö: DISKPART [/S tiedostonimi] [/T aikakatkaisu] [/?]\n\n\
/S tiedostonimi\tSuorittaa annetun komentosarjan.\n\
/T aikakatkaisu\tAikakatkaisu sekunteina DiskPartin päällekkäisen käytön estämiseksi.\n\
/?\t\tNäyttää tämän ohjeen.\n\n"
    IDS_APP_LICENSE "Lisensoitu GNU GPLv2 -lisenssillä\n"
    IDS_APP_CURR_COMPUTER "Tietokoneessa: %s\n\n"
    IDS_APP_LEAVING "\nPoistutaan DiskPartista...\n"
    IDS_APP_PROMPT "DISKPART> "
END

/* ACTIVE command strings */
STRINGTABLE
BEGIN
    IDS_ACTIVE_FAIL "\nDiskPart ei voinut merkitä osiota aktiiviseksi.\nVarmista, että osio on kelvollinen.\n"
    IDS_ACTIVE_SUCCESS "\nDiskPart merkitsi nykyisen osion aktiiviseksi.\n"
    IDS_ACTIVE_ALREADY "\nNykyinen osio on jo merkitty aktiiviseksi.\n"
    IDS_ACTIVE_NO_MBR "\nValittu levy ei ole MBR-levy.\nACTIVE-komentoa voi käyttää vain MBR-levyllä.\n"
END

/* ASSIGN command strings */
STRINGTABLE
BEGIN
    IDS_ASSIGN_FAIL "\nDiskPart ei voinut määrittää asemakirjainta tai liitoskohtaa.\nVarmista, että asemakirjain tai liitoskohta on kelvollinen.\n"
    IDS_ASSIGN_SUCCESS "\nDiskPart määritti asemakirjaimen tai liitoskohdan.\n"
    IDS_ASSIGN_ALREADY_ASSIGNED "\nMääritetty kirjain on jo määritetty tälle asemalle.\n"
    IDS_ASSIGN_INVALID_LETTER "\nMäärittämäsi kirjain ei ole kelvollinen taltion kirjain.\n"
    IDS_ASSIGN_NO_MORE_LETTER "\nVapaita asemakirjaimia ei ole määritettäväksi tälle taltiolle.\nVapauta jokin asemakirjain ja yritä uudelleen.\n"
    IDS_ASSIGN_SYSTEM_VOLUME "\nDiskPart ei voi vaihtaa järjestelmä-, käynnistys- tai sivutustiedostotaltion asemakirjainta.\n"
END

