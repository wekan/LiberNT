    IDS_SHRINK_AVAILABLE "Käytettävissä oleva kutistettava tila (Mt):"
    IDS_SHRINK_AMOUNT "&Anna kutistettavan tilan määrä (Mt):"
    IDS_SHRINK_AFTER "Kokonaiskoko kutistamisen jälkeen (Mt):"
    IDS_SHRINK_BUTTON "&Kutista"
    IDS_EXTEND_TOTAL "Kokonaiskoko ennen laajentamista (Mt):"
    IDS_EXTEND_AVAILABLE "Käytettävissä oleva tila (Mt):"
    IDS_EXTEND_AMOUNT "&Anna lisättävän tilan määrä (Mt):"
